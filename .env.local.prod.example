# =========================
# WORKPLACE - PRODUCCIÓN LOCAL (PLANTILLA)
# =========================
# Configuración de producción para desarrollo local.
# Este archivo SÍ se versiona como plantilla — NO debe contener secretos reales.
# Copiar a .env y reemplazar los valores CHANGE_ME_* con secretos generados
# (openssl rand -base64 32), distintos de los usados en cualquier otro entorno.

# =========================
# APP CONFIGURACIÓN
# =========================
APP_NAME=
APP_ENV=
USE_DEMO=

EMAIL=

NODE_PORT=
FRONTEND_PORT=
NITRO_HOST=

# =========================
# NODE MEMORY CONFIGURACIÓN
# =========================
NODE_OPTIONS=
# Limita el uso de memoria de Node.js a 512MB por contenedor

# =========================
# NGINX CONFIGURACIÓN
# =========================
HTTP_PORT=
HTTPS_PORT=

# Certbot Settings
STAGING_MODE=
DEV_MODE=

# =========================
# POSTGRESQL (Docker internal)
# =========================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# =========================
# Redis (Docker internal)
# =========================
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# =========================
# JWT CONFIGURACIÓN (PRODUCCIÓN LOCAL)
# =========================
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# =========================
# CIFRADO (2FA - secretos TOTP en reposo, AES-256-GCM)
# =========================
ENCRYPTION_KEY=

# =========================
# URLs CONFIGURACIÓN (PRODUCCIÓN - MONOLITO)
# =========================
DOMAIN=
FRONTEND_URL=
API_URL=

# =========================
# DOCKER CONFIGURACIÓN
# =========================
DOCKER_USER=

# =========================
# GOOGLE OAUTH (OPCIONAL)
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================
# CORREO (verificación, recuperación de contraseña y avisos de solicitudes)
# =========================
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=WorkPlace

# =========================
# PUSH (notificaciones de la APK en segundo plano, Firebase Cloud Messaging)
# =========================
# Cuenta de servicio de Firebase: el JSON completo en una línea, o las tres
# variables sueltas. Vacío = push desactivado (la app sigue funcionando).
# Ver frontend/docs/PUSH_NOTIFICATIONS.md.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =========================
# SUPERADMIN INICIAL (solo primera instalación)
# =========================
# `docker compose exec backend node prisma/seed.js --production` crea este
# SUPERADMIN si todavía no existe ninguno (mín. 12 caracteres, con mayúsculas,
# minúsculas y números). Bórralos del .env cuando el seed termine.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Plazos de la garantía (pago protegido) de pedidos de catálogo, en días.
# Sin respuesta del comercio → reembolso; sin confirmación del comprador → se libera.
# CATALOG_ESCROW_RESPONSE_DAYS=3
# CATALOG_ESCROW_AUTO_RELEASE_DAYS=7

# Funciones con implicaciones legales/regulatorias (apagadas por defecto;
# el frontend las lee de GET /api/features). Encender solo con 'true' y
# tras validación legal/contable.
# Pago Protegido: la plataforma retiene dinero del comprador (custodia).
# PROTECTED_PAYMENTS_ENABLED=false
# Financiamiento Cashea/Krece (sin integración real todavía).
# BNPL_ENABLED=false
# Créditos de uso prepagados (pendiente de dictamen legal).
# USAGE_CREDITS_ENABLED=false
