# ---------- BASE ----------
FROM node:20-alpine AS base

WORKDIR /app

# Habilitar pnpm solo para builds
RUN corepack enable && corepack prepare pnpm@latest --activate

# ---------- DEPENDENCIAS ----------
FROM base AS deps

# Copiar lockfiles para cache
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY frontend/package.json ./frontend/

# Instalar dependencias con cache
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline

# ---------- BUILD ----------
FROM deps AS builder

WORKDIR /app/frontend

# Copiar código fuente optimizado
COPY frontend/nuxt.config.ts ./
COPY frontend/assets ./assets
COPY frontend/components ./components
COPY frontend/layouts ./layouts
COPY frontend/pages ./pages
COPY frontend/plugins ./plugins
COPY frontend/server ./server
COPY frontend/utils ./utils
COPY frontend/app.vue ./

# Construir Nuxt con memoria extendida
RUN NODE_OPTIONS="--max-old-space-size=2048" pnpm run build \
    && rm -rf .nuxt/.cache node_modules/.cache

# ---------- PRODUCCIÓN ----------
FROM node:20-alpine AS production

# Dependencias runtime mínimas
RUN apk add --no-cache dumb-init ca-certificates curl

WORKDIR /app

# Copiar solo el build optimizado
COPY --from=builder /app/frontend/.output ./.output

# Crear usuario no root
RUN addgroup -S -g 1001 app && \
    adduser -S -D -H -u 1001 -h /app -s /sbin/nologin -G app app && \
    chown -R app:app /app

USER app

# Healthcheck liviano
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD node -e "require('http').get('http://localhost:' + (process.env.NITRO_PORT || 3000) + '/', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

# Exponer puerto desde .env con fallback
EXPOSE ${NITRO_PORT:-3000}

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", ".output/server/index.mjs"]