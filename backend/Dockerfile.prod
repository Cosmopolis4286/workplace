# ---------- BUILD ----------
FROM node:20-alpine AS build

# Dependencias para compilar Nest/Prisma
RUN apk add --no-cache python3 make g++ git openssl-dev \
    && corepack enable \
    && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Copiar lockfiles para caching
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY backend/package.json ./backend/

# Instalar deps dev + prod
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod=false

# Copiar código fuente
COPY backend/src ./backend/src
COPY backend/prisma ./backend/prisma
COPY backend/tsconfig*.json ./backend/
COPY scripts ./scripts

WORKDIR /app/backend

# Generar Prisma Client y build TS
RUN pnpm prisma generate \
    && pnpm build \
    && pnpm exec tsc -p tsconfig.seed.json

# Limpiar deps dev antes de pasar a producción
RUN pnpm prune --prod

# ---------- PRODUCTION ----------
FROM node:20-alpine AS production

ENV NODE_OPTIONS="--max-old-space-size=2048"

# Dependencias mínimas runtime
RUN apk add --no-cache dumb-init ca-certificates openssl libssl3 python3 make g++ curl netcat-openbsd

WORKDIR /app

# Copiar solo lo esencial desde build
COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/scripts/init-backend-prod.sh ./scripts/init-backend-prod.sh
COPY --from=build /app/backend/package.json ./backend/package.json
COPY --from=build /app/backend/prisma ./backend/prisma
COPY --from=build /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build /app/backend/node_modules ./backend/node_modules

WORKDIR /app/backend

# Generar cliente Prisma (opcional, ya lo hicimos en build)
RUN npx prisma@5.22.0 generate

# Usuario no root
RUN addgroup -S -g 1001 app && \
    adduser -S -D -H -u 1001 -h /app -s /sbin/nologin -G app app && \
    chown -R app:app /app
USER app

EXPOSE 3001

ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "/app/scripts/init-backend-prod.sh"]