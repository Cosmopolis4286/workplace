# ---------- BUILD ----------
FROM node:20-alpine AS build

# Dependencias para compilar Nest/Prisma
RUN apk add --no-cache python3 make g++ git openssl-dev \
    && corepack enable \
    && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Copiar lockfiles y package.json para caching
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY backend/package.json ./backend/

# Instalar deps dev + prod
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod=false

# Copiar solo lo necesario del backend
COPY backend/src ./backend/src
COPY backend/prisma ./backend/prisma
COPY backend/tsconfig*.json ./backend/
COPY scripts/init.sh ./scripts/

WORKDIR /app/backend

# Generar Prisma Client y build TS
RUN pnpm prisma generate \
    && pnpm build \
    && pnpm exec tsc -p tsconfig.seed.json

# Limpieza agresiva pero segura
RUN rm -rf node_modules/.cache 2>/dev/null || true \
    && find node_modules -name "*.md" -delete 2>/dev/null || true \
    && find node_modules -name "*.txt" -delete 2>/dev/null || true \
    && find node_modules -name "LICENSE*" -delete 2>/dev/null || true \
    && find node_modules -name "CHANGELOG*" -delete 2>/dev/null || true \
    && find node_modules -name "README*" -delete 2>/dev/null || true \
    && find node_modules -name "*.map" -delete 2>/dev/null || true \
    && find node_modules -name "test*" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find node_modules -name "tests*" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find node_modules -name "__tests__*" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find node_modules -name "*.ts" -delete 2>/dev/null || true \
    && find node_modules -name "*.js" -not -path "*/node_modules/prisma/*" -not -path "*bcrypt*" -delete 2>/dev/null || true \
    && find node_modules -name "d.ts" -not -path "*/node_modules/prisma/*" -delete 2>/dev/null || true \
    && find node_modules -name "*.node" -not -path "*/node_modules/prisma/*" -not -path "*bcrypt*" -delete 2>/dev/null || true \
    && rm -rf /tmp/* /var/tmp/* /root/.cache 2>/dev/null || true

# ---------- PRODUCTION ----------
FROM node:20-alpine AS production

# Variables opcionales
ENV NODE_OPTIONS="--max-old-space-size=128"

# Dependencias mínimas de runtime
RUN apk add --no-cache dumb-init ca-certificates openssl libssl3

WORKDIR /app

# Copiar solo lo necesario desde build
COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/backend/prisma ./backend/prisma
COPY --from=build /app/backend/package.json ./backend/package.json
COPY --from=build /app/scripts/init.sh ./scripts/init.sh
COPY --from=build /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

WORKDIR /app/backend

# Instalar solo deps de producción necesarias
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    corepack enable && corepack prepare pnpm@9.15.0 --activate \
    && pnpm install --frozen-lockfile --prod --ignore-scripts

# Generar cliente Prisma
WORKDIR /app/backend
RUN npx prisma@5.22.0 generate

# Permisos y usuario no root
RUN addgroup -S -g 1001 app && \
    adduser -S -D -H -u 1001 -h /app -s /sbin/nologin -G app app && \
    chown -R app:app /app
USER app

EXPOSE ${NODE_PORT}

ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "/app/scripts/init-prod.sh"]