# ---------- BUILD ----------
FROM node:20-alpine AS build

# Dependencias para compilar Nest/Prisma
RUN apk add --no-cache python3 make g++ git openssl-dev libcrypto3 libssl3 \
    && corepack enable \
    && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Copiar solo lockfiles para caching
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY backend/package.json ./backend/

# Instalar deps dev + prod
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod=false

# Copiar código fuente y generar build
COPY backend/src ./backend/src
COPY backend/prisma ./backend/prisma
COPY backend/tsconfig*.json ./backend/
COPY scripts ./scripts

WORKDIR /app/backend

# Generar Prisma Client y build TS
RUN pnpm prisma generate \
    && pnpm build

# Limpiar deps de desarrollo antes de copiar a producción
RUN pnpm prune --prod --config.interactive=false

# ---------- PRODUCTION ----------
FROM node:20-alpine AS production

# Build args para metadata de la version
ARG GIT_SHA=unknown
ARG APP_VERSION=1.0.0
ARG BUILD_TIME

# Variables de entorno
ENV NODE_OPTIONS="--max-old-space-size=2048"
ENV GIT_SHA=${GIT_SHA}
ENV APP_VERSION=${APP_VERSION}
ENV BUILD_TIME=${BUILD_TIME}
# Prisma: usar OpenSSL 3.x disponible en Alpine
ENV PRISMA_CLI_QUERY_ENGINE_TYPE=library
ENV PRISMA_CLI_FETCH_ENGINE=libquery

# Dependencias mínimas de runtime - solo lo necesario
RUN apk add --no-cache dumb-init ca-certificates openssl libssl3 libcrypto3 python3 make g++ curl netcat-openbsd

WORKDIR /app

# Copiar solo lo esencial desde build
COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/backend/src/mail/templates ./backend/dist/src/mail/templates
COPY --from=build /app/scripts/deployment/init-backend-prod.sh ./scripts/deployment/init-backend-prod.sh
COPY --from=build /app/backend/prisma ./backend/prisma
COPY --from=build /app/backend/package.json ./backend/package.json
COPY --from=build /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

WORKDIR /app/backend

# Instalar solo deps de producción necesarias
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    corepack enable && corepack prepare pnpm@9.15.0 --activate && \
    pnpm install --prod

# Generar cliente Prisma
RUN pnpm prisma generate

# Permisos y usuario no root
RUN addgroup -S -g 1001 app && \
    adduser -S -D -H -u 1001 -h /app -s /sbin/nologin -G app app && \
    chown -R app:app /app && \
    # Asegurar permisos correctos para seed.js
    chown app:app prisma/seed.js

USER app

EXPOSE ${NODE_PORT}

# Health check para verificar que el backend esté funcionando
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
  CMD curl -fs http://localhost:3001/api/health > /dev/null || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "/app/scripts/deployment/init-backend-prod.sh"]