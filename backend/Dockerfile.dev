# ---------- BASE ----------
FROM node:20-alpine AS base

# Instalar dependencias del sistema y pnpm
RUN apk add --no-cache python3 make g++ git openssl-dev openssl \
    && corepack enable \
    && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# ---------- BACKEND ----------
FROM base AS backend

WORKDIR /app/backend

# Copiar archivos de configuración del backend
COPY backend/package.json ./package.json
COPY pnpm-lock.yaml ./pnpm-lock.yaml
COPY backend/prisma ./prisma

# Instalar dependencias del backend (TODAS - incluye dev y prisma)
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --no-frozen-lockfile

# Copiar código fuente
COPY backend/src ./src

# Generar Prisma Client
RUN pnpm prisma:generate

EXPOSE 3001

# Regenerar Prisma client y correr migraciones en cada arranque para
# que el volumen montado siempre tenga el cliente actualizado con el schema actual
CMD ["sh", "-c", "pnpm prisma:generate && sh scripts/migrate-deploy.sh && node scripts/seed-if-empty.js && pnpm dev"]
