// ─── Plans & Subscriptions ────────────────────────────────────────────────────

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  PENDING
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model Plan {
  id          String     @id @default(uuid())
  name        String
  description String?
  price       Float
  priceAnnual Float? // descuento anual (opcional)
  status      PlanStatus @default(ACTIVE)
  isPopular   Boolean    @default(false)
  color       String     @default("#3B82F6")
  sortOrder   Int        @default(0)

  // Targets
  forCommerce   Boolean @default(true)
  forFreelancer Boolean @default(false)
  forNormal     Boolean @default(false) // Planes para usuarios NORMAL

  // Categorías de negocio asociadas (para filtrado en onboarding)
  categoryIds String[] @default([])

  // Límites (-1 = ilimitado)
  maxProducts        Int @default(50)
  maxEmployees       Int @default(5)
  maxBranches        Int @default(1)
  maxOrders          Int @default(-1) // por mes
  maxStorage         Int @default(1) // GB
  maxServices        Int @default(-1) // servicios ACTIVOS simultáneos (freelancer)
  maxServiceRequests Int @default(-1) // solicitudes recibidas por mes (freelancer)
  maxJobs            Int @default(-1) // empleos ACTIVOS simultáneos publicados

  // Features habilitadas (bullets de marketing)
  features Json @default("[]") // string[]

  // Módulos habilitados — valores coinciden con Permission.module del seed
  enabledModules String[] @default([])

  subscriptions      Subscription[]
  feeOverrides       PlatformFeeOverride[]
  pendingForProfiles UserProfile[]
  featureRules       PlanFeatureRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id       String             @id @default(uuid())
  userId   String
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status   SubscriptionStatus @default(ACTIVE)
  interval BillingInterval    @default(MONTHLY)

  startAt   DateTime  @default(now())
  endAt     DateTime?
  trialEnds DateTime?

  // Snapshot del precio al momento de suscribirse
  pricePaid Float @default(0)

  // Quién asignó (superadmin o auto)
  assignedBy String? // userId del admin

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

enum FeatureUsageMode {
  // Se consume una sola vez: al usarla (o al expirar) queda agotada para
  // siempre, no se puede volver a activar.
  SINGLE_USE
  // Se activa una vez y otorga N usos consumibles dentro de su ventana de
  // tiempo (ej. "10 créditos de IA en 30 días"). Al agotar los usos O expirar
  // la ventana (lo que ocurra primero), queda agotada.
  MULTI_USE
  // Al expirar (o agotarse), el usuario puede volver a activarla desde cero
  // — sin límite de veces. Distinto del trial (que es una sola vez de por
  // vida): esto es para features que se pueden "reprobar" repetidamente.
  REACTIVATABLE
}

enum FeatureGrantStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  REVOKED
}

enum FeatureGrantSource {
  SELF_SERVICE
  ADMIN
}

// Qué features puede activar un plan por autoservicio, y con qué reglas —
// separado de FeatureGrant (la activación real) igual que Plan está separado
// de Subscription. featureKey es un string libre (no solo módulos del
// sidebar): puede ser un módulo temporal ("business_shield"), un límite
// puntual ("extra_branch_slot") o un consumible ("ai_credits_10"). Ver
// pedido de negocio: "cada plan pueda activar X módulos/funciones por X
// tiempo, de uso único, múltiple o reactivable" (2026-09-05).
model PlanFeatureRule {
  id         String @id @default(uuid())
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String

  durationDays Int
  usageMode    FeatureUsageMode
  // Solo tiene sentido con usageMode=MULTI_USE — cuántos usos otorga cada
  // activación. null en SINGLE_USE (implícitamente 1) y REACTIVATABLE
  // (ilimitado dentro de la ventana, lo que expira es el tiempo, no los usos).
  maxUses      Int?

  active Boolean @default(true)
  label  String? // nombre human-readable para mostrar en el panel de admin/usuario

  grants FeatureGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, featureKey])
  @@map("plan_feature_rules")
}

// Una activación concreta de una feature — por autoservicio (siguiendo una
// PlanFeatureRule) o otorgada manualmente por un admin sin regla de plan
// (cortesía, soporte puntual a un cliente). Snapshot de usageMode/duración al
// momento de activar: si la regla del plan cambia después, los grants ya
// emitidos no se alteran retroactivamente (mismo criterio que el snapshot de
// tasa de cambio en Purchase/SupplierQuote).
model FeatureGrant {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureKey String
  ruleId     String?
  rule       PlanFeatureRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  source    FeatureGrantSource
  grantedBy String? // userId del admin si source=ADMIN; null si SELF_SERVICE

  usageMode     FeatureUsageMode
  // null = no aplica (SINGLE_USE ya consumido al usar, REACTIVATABLE no lleva contador).
  usesRemaining Int?

  activatedAt DateTime           @default(now())
  expiresAt   DateTime?
  status      FeatureGrantStatus @default(ACTIVE)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, featureKey, status])
  @@index([expiresAt])
  @@map("feature_grants")
}

// ─── Platform Fees ────────────────────────────────────────────────────────────

enum FeeTransactionType {
  ORDER
  SERVICE_REQUEST
  RIDE
}

enum FeePayer {
  CLIENT // se suma al total que paga el cliente
  PROVIDER // se descuenta de lo que recibe el proveedor/comercio/conductor (vía Wallet)
}

// Tasa global por tipo de transacción, gestionada por SUPERADMIN.
model PlatformFeeRate {
  id          String             @id @default(uuid())
  type        FeeTransactionType
  rate        Float // porcentaje, ej. 10 = 10%
  payer       FeePayer
  isActive    Boolean            @default(true)
  updatedById String? // SUPERADMIN que hizo el cambio

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@map("platform_fee_rates")
}

// Override opcional por plan o por usuario específico. Prioridad de resolución:
// override por userId > override por planId > PlatformFeeRate global.
model PlatformFeeOverride {
  id       String             @id @default(uuid())
  type     FeeTransactionType
  rate     Float
  payer    FeePayer? // null = hereda el payer del rate global
  planId   String?
  plan     Plan?              @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, userId])
  @@index([type, planId])
  @@index([planId])
  @@index([userId])
  @@map("platform_fee_overrides")
}

// ─── Auth Tokens ─────────────────────────────────────────────────────────────

model PasswordResetToken {
