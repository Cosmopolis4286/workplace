enum RideStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RideVehicleType {
  MOTORCYCLE
  CAR
  PICKUP_TRUCK
  TRUCK
}

enum RideServiceType {
  PASSENGER
  FREIGHT
}

model Ride {
  id                String          @id @default(uuid())
