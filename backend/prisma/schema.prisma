// ─── Services (marketplace) ───────────────────────────────────────────────────

enum ServiceStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

model ServiceCategory {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#3B82F6")
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]

  @@map("service_categories")
}

model ServiceModality {
  id        String   @id @default(uuid())
  name      String   @unique
  value     String   @unique
  emoji     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_modalities")
}

model Service {
  id              String           @id @default(uuid())
  name            String
  description     String?
  price           Float
  priceUnit       String?
  duration        Int? // minutos estimados
  images          String[]         @default([]) // [0] = principal, [1..2] = secundarias
  status          ServiceStatus    @default(ACTIVE)
  // El proveedor decide, por servicio, si la plataforma retiene el pago en
  // garantía (escrow) hasta completar el trabajo. Cambiarlo solo afecta
  // solicitudes NUEVAS — las que ya están en curso guardan su propio modo
  // en ServiceRequest.escrowStatus/escrowAmount al momento de crearse.
  hasEscrow       Boolean          @default(false)
  tags            String[]
  modalities      String[]
  itemFields      String[]         @default([]) // plantilla de campos por ítem, ej. ["Marca", "Modelo"]
  categoryId      String?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  serviceRequests ServiceRequest[]
  serviceEvents   ServiceEvent[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("services")
}

enum ServiceRequestStatus {
  PENDING
  SEEN
  CONTACTED
  CLOSED
  CANCELLED
  REJECTED
}

enum ServiceRequestModality {
  IN_PERSON
  REMOTE
  ANY
}

// NONE: el servicio no usa escrow (modelo actual, pago directo fuera de la
//   plataforma; solo se cobra comisión al proveedor al completar).
// HELD: fondos retenidos en la wallet del usuario de sistema de plataforma.
// PENDING_FUNDS: el precio quedó fijado pero el cliente no tenía saldo
//   suficiente para la retención — se reintenta automáticamente (hook de
//   depósito + cron de respaldo) hasta lograr HELD.
// RELEASED: fondos liberados al proveedor (menos comisión) al completar.
// REFUNDED: fondos devueltos al cliente (cancelación/rechazo).
enum EscrowStatus {
  NONE
  HELD
  PENDING_FUNDS
  RELEASED
  REFUNDED
}

model ServiceRequest {
  id                   String                              @id @default(uuid())
  serviceId            String
  service              Service                             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceName          String
  providerId           String
  providerName         String
  modality             ServiceRequestModality              @default(ANY)
  preferredDate        DateTime
  address              String?
  city                 String?
  clientName           String
  clientPhone          String
  clientEmail          String?
  description          String?
  price                Float?
  priceUnit            String?
  platformFeeRate      Float?
  platformFeeAmount    Float?
  platformFeePayer     FeePayer?
  // Escrow opcional (Service.hasEscrow) — retención del monto total en la
  // wallet de plataforma entre la fijación de precio y la finalización.
  escrowStatus         EscrowStatus                        @default(NONE)
  escrowAmount         Float?
  escrowHeldAt         DateTime?
  status               ServiceRequestStatus                @default(PENDING)
  providerNotes        String?
  statusUpdatedAt      DateTime?
  // Marca cuándo se envió el recordatorio automático por falta de respuesta del
  // proveedor (cron); evita reenviarlo en cada corrida del scheduler.
  reminderSentAt       DateTime?
  requesterId          String?
  requester            User?                               @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  items                ServiceRequestItem[]
  statusHistory        ServiceRequestStatusHistory[]
  messages             ServiceRequestMessage[]
  priceChangeProposals ServiceRequestPriceChangeProposal[]
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt

  @@index([serviceId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  // Acelera el scheduler de recordatorios: WHERE status='PENDING' AND createdAt<=X AND reminderSentAt IS NULL
  @@index([status, reminderSentAt, createdAt])
  // Acelera getAvgResponseHours/getSuggestedPrice: WHERE providerId=X AND status IN (...)
  @@index([providerId, status])
  // Acelera getSuggestedPrice: WHERE serviceId=X AND providerId=Y AND status='CLOSED'
  @@index([serviceId, providerId, status])
  // Acelera el cron de reintento de escrow: WHERE escrowStatus='PENDING_FUNDS'
  @@index([escrowStatus])
  @@index([requesterId])
  @@map("service_requests")
}

// Chat 1:1 entre cliente y proveedor sobre una ServiceRequest concreta.
// Reemplaza el "contactar por teléfono" del modal — deja registro dentro de
// la plataforma y habilita mediar disputas más adelante. Solo existe si la
// solicitud tiene requesterId (cliente autenticado); una solicitud anónima
// (solo clientPhone) no tiene con quién chatear del lado de la plataforma.
model ServiceRequestMessage {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body             String
  readAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId, createdAt])
  @@index([serviceRequestId, readAt])
  @@index([senderId])
  @@map("service_request_messages")
}

model ServiceRequestStatusHistory {
  id               String                @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  previousStatus   ServiceRequestStatus?
  newStatus        ServiceRequestStatus
  changedBy        String? // userId si fue una acción de usuario; null si fue automático (ej. scheduler)
  createdAt        DateTime              @default(now())

  @@index([serviceRequestId])
  @@index([createdAt(sort: Desc)])
  @@map("service_request_status_history")
}

enum ServiceRequestProposalStatus {
  PENDING
  APPROVED
  APPROVED_PENDING_FUNDS
  REJECTED
  INVALIDATED
}

// Propuesta del proveedor de agregar ítems/aumentar el precio de una
// ServiceRequest ya en curso (status=CONTACTED). Requiere aprobación
// explícita del cliente antes de tocar el escrow — nunca se autoaplica.
// Ver ServicesService.approvePriceChangeProposal.
model ServiceRequestPriceChangeProposal {
  id               String                       @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest               @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  status           ServiceRequestProposalStatus @default(PENDING)
  previousPrice    Float
  proposedPrice    Float
  deltaAmount      Float
  note             String?
  proposedBy       String
  resolvedBy       String?
  resolvedAt       DateTime?
  rejectionReason  String?
  // reference usada en WalletsService.holdEscrow al aprobar (o al reintentar
  // tras APPROVED_PENDING_FUNDS) — distinta de la retención inicial para que
  // el libro de movimientos de la wallet no confunda ambos holds.
  escrowReference  String?
  items            ServiceRequestProposalItem[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([serviceRequestId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("service_request_price_change_proposals")
}

model ServiceRequestProposalItem {
  id         String                            @id @default(uuid())
  proposalId String
  proposal   ServiceRequestPriceChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fields     Json                              @default("{}")
  notes      String?
  photos     String[]                          @default([])
  videos     String[]                          @default([])
  sortOrder  Int                               @default(0)
  createdAt  DateTime                          @default(now())

  @@index([proposalId])
  @@map("service_request_proposal_items")
}

model ServiceRequestItem {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  fields           Json           @default("{}") // { "Marca": "Bosch", "Modelo": "X200" } — claves = itemFields del Service
  notes            String?
  photos           String[]       @default([]) // hasta 6 URLs
  videos           String[]       @default([]) // hasta 2 URLs
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
  @@map("service_request_items")
}

enum ServiceEventType {
  VIEW // alguien abrió el anuncio del servicio
  PROFILE_VISIT // alguien hizo click en "Ver perfil" del proveedor
  REQUEST // alguien envió una solicitud de servicio
}

model ServiceEvent {
  id        String           @id @default(uuid())
  serviceId String
  service   Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type      ServiceEventType
  viewerId  String? // usuario autenticado que generó el evento (opcional)
  createdAt DateTime         @default(now())

  @@index([serviceId])
  @@index([serviceId, type])
  @@index([createdAt(sort: Desc)])
  @@map("service_events")
}

// Búsquedas de /search/suggest que no encontraron resultados en ningún tab —
// demanda insatisfecha para el Opportunity Engine (ver ServicesService.
// getOpportunities, que combina esto con ServiceRequest ya confirmadas).
model UnmetSearch {
  id        String   @id @default(uuid())
  query     String
  city      String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([city])
  @@map("unmet_searches")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     LogLevel @default(INFO)
  message   String
  context   String?
  stack     String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt(sort: Desc)])
  @@map("system_logs")
}

