  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

enum ReviewReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model Review {
  id       String  @id @default(uuid())
  rating   Int
  comment  String?
  authorId String
  author   User    @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  targetId String
  target   User    @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  // Verificación de transacción real: referencia a la orden/solicitud que habilitó la reseña
  verifiedOrderId   String?
  verifiedRequestId String?

  // Respuesta pública del negocio/freelancer reseñado
  response    String?
  respondedAt DateTime?

  // Moderación
  isHidden Boolean        @default(false)
  reports  ReviewReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, targetId])
  @@index([targetId, isHidden])
  @@map("reviews")
}

model ReviewReport {
  id         String             @id @default(uuid())
  reviewId   String
  review     Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String
  status     ReviewReportStatus @default(PENDING)
  createdAt  DateTime           @default(now())

  @@unique([reviewId, reporterId])
  @@index([status])
  @@map("review_reports")
}

// ─── Permission Matrix ────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  action      String
  label       String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  rolePermissions    RolePermission[]
  userPermissions    UserPermission[]
  profilePermissions ProfilePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  updatedAt    DateTime   @updatedAt
  updatedBy    String?

  @@unique([role, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Permisos por UserProfile (perfiles múltiples — ver UserProfile más arriba).
// Independiente de RolePermission: SUPERADMIN/ADMIN/NORMAL siguen usando
// RolePermission (no son "perfiles de negocio"). Un usuario con varios
// UserProfile ACTIVE obtiene la UNIÓN de los permisos de cada uno
// (ver PermissionsService.hasEffectivePermission). `subtype` es NULL para
// CUSTOMER/JOB_SEEKER/BUSINESS (no aplica) y obligatorio en la práctica para
// PROFESSIONAL (FREELANCER vs SERVICE_PROVIDER pueden diferir a futuro,
// aunque el bootstrap inicial les da los mismos valores).
model ProfilePermission {
  id           String               @id @default(uuid())
  profileType  ProfileType
  subtype      ProfessionalSubtype?
  permissionId String
  permission   Permission           @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean              @default(true)
  updatedAt    DateTime             @updatedAt
  updatedBy    String?

  @@unique([profileType, subtype, permissionId])
  @@index([permissionId])
  @@map("profile_permissions")
}

// Permisos individuales por usuario (sobrescriben los del rol)
model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true) // true = concedido, false = denegado explícitamente
  reason       String? // Razón de la asignación especial
  expiresAt    DateTime? // Expiración opcional
  updatedAt    DateTime   @updatedAt
  updatedBy    String?

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

// Catálogo canónico de módulos de la plataforma (fue solo un kill-switch de
// excepciones; ahora es la fuente de verdad completa — antes vivía como
// array hardcodeado en common/data/module-catalog.data.ts, duplicado a mano
// en varios lugares del frontend). Cada módulo real tiene SIEMPRE una fila
// acá (no solo los que un admin tocó alguna vez).
//
// `enabled`: kill-switch global — deshabilitado desaparece del sidebar de
// TODO usuario sin importar rol/plan/categoría, incluido SUPERADMIN.
// `isBusinessModule`: si participa en plan∩categoría (Plan.enabledModules /
// UserCategory.allowedModules) — false para módulos "de sistema" (users,
// permissions, audit...) que solo agrupan permisos y nunca están en un plan.
model SystemModule {
  id               String   @id @default(uuid())
  module           String   @unique
  label            String
  enabled          Boolean  @default(true)
  isBusinessModule Boolean  @default(false)
  isSystemDefault  Boolean  @default(false) // seed original — no se puede borrar, sí renombrar/deshabilitar
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedBy        String?

  @@map("system_modules")
}

// ─── Audit & Logs ─────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  UPLOAD
  EXPORT
  VIEW
  OTHER
}

