enum ServiceStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

model ServiceCategory {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#3B82F6")
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]

  @@map("service_categories")
}

model ServiceModality {
  id        String   @id @default(uuid())
  name      String   @unique
  value     String   @unique
  emoji     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_modalities")
}

model Service {
  id              String           @id @default(uuid())
  name            String
  description     String?
  price           Float
  priceUnit       String?
  duration        Int? // minutos estimados
  image           String?
  status          ServiceStatus    @default(ACTIVE)
  // El proveedor decide, por servicio, si la plataforma retiene el pago en
  // garantía (escrow) hasta completar el trabajo. Cambiarlo solo afecta
  // solicitudes NUEVAS — las que ya están en curso guardan su propio modo
  // en ServiceRequest.escrowStatus/escrowAmount al momento de crearse.
  hasEscrow       Boolean          @default(false)
  tags            String[]
  modalities      String[]
  itemFields      String[]         @default([]) // plantilla de campos por ítem, ej. ["Marca", "Modelo"]
  categoryId      String?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  serviceRequests ServiceRequest[]
  serviceEvents   ServiceEvent[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("services")
}

enum ServiceRequestStatus {
  PENDING
  SEEN
  CONTACTED
  CLOSED
  CANCELLED
  REJECTED
}

enum ServiceRequestModality {
  IN_PERSON
  REMOTE
  ANY
}

// NONE: el servicio no usa escrow (modelo actual, pago directo fuera de la
//   plataforma; solo se cobra comisión al proveedor al completar).
// HELD: fondos retenidos en la wallet del usuario de sistema de plataforma.
// PENDING_FUNDS: el precio quedó fijado pero el cliente no tenía saldo
//   suficiente para la retención — se reintenta automáticamente (hook de
//   depósito + cron de respaldo) hasta lograr HELD.
// RELEASED: fondos liberados al proveedor (menos comisión) al completar.
// REFUNDED: fondos devueltos al cliente (cancelación/rechazo).
enum EscrowStatus {
  NONE
  HELD
  PENDING_FUNDS
  RELEASED
  REFUNDED
}

model ServiceRequest {
  id                String                        @id @default(uuid())
  serviceId         String
  service           Service                       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceName       String
  providerId        String
  providerName      String
  modality          ServiceRequestModality        @default(ANY)
  preferredDate     DateTime
  address           String?
  city              String?
  clientName        String
  clientPhone       String
  clientEmail       String?
  description       String?
  price             Float?
  priceUnit         String?
  platformFeeRate   Float?
  platformFeeAmount Float?
  platformFeePayer  FeePayer?
  // Escrow opcional (Service.hasEscrow) — retención del monto total en la
  // wallet de plataforma entre la fijación de precio y la finalización.
  escrowStatus      EscrowStatus                  @default(NONE)
  escrowAmount      Float?
  escrowHeldAt      DateTime?
  status            ServiceRequestStatus          @default(PENDING)
  providerNotes     String?
  statusUpdatedAt   DateTime?
  // Marca cuándo se envió el recordatorio automático por falta de respuesta del
  // proveedor (cron); evita reenviarlo en cada corrida del scheduler.
  reminderSentAt    DateTime?
  requesterId       String?
  requester         User?                         @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  items             ServiceRequestItem[]
  statusHistory     ServiceRequestStatusHistory[]
  messages          ServiceRequestMessage[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([serviceId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  // Acelera el scheduler de recordatorios: WHERE status='PENDING' AND createdAt<=X AND reminderSentAt IS NULL
  @@index([status, reminderSentAt, createdAt])
  // Acelera getAvgResponseHours/getSuggestedPrice: WHERE providerId=X AND status IN (...)
  @@index([providerId, status])
  // Acelera getSuggestedPrice: WHERE serviceId=X AND providerId=Y AND status='CLOSED'
  @@index([serviceId, providerId, status])
  // Acelera el cron de reintento de escrow: WHERE escrowStatus='PENDING_FUNDS'
  @@index([escrowStatus])
  @@map("service_requests")
}

// Chat 1:1 entre cliente y proveedor sobre una ServiceRequest concreta.
// Reemplaza el "contactar por teléfono" del modal — deja registro dentro de
// la plataforma y habilita mediar disputas más adelante. Solo existe si la
// solicitud tiene requesterId (cliente autenticado); una solicitud anónima
// (solo clientPhone) no tiene con quién chatear del lado de la plataforma.
model ServiceRequestMessage {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body             String
  readAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId, createdAt])
  @@map("service_request_messages")
}

model ServiceRequestStatusHistory {
  id               String                @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  previousStatus   ServiceRequestStatus?
  newStatus        ServiceRequestStatus
  changedBy        String? // userId si fue una acción de usuario; null si fue automático (ej. scheduler)
  createdAt        DateTime              @default(now())

  @@index([serviceRequestId])
  @@index([createdAt(sort: Desc)])
  @@map("service_request_status_history")
}

model ServiceRequestItem {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  fields           Json           @default("{}") // { "Marca": "Bosch", "Modelo": "X200" } — claves = itemFields del Service
  notes            String?
  photos           String[]       @default([]) // hasta 6 URLs
  videos           String[]       @default([]) // hasta 2 URLs
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
  @@map("service_request_items")
}

enum ServiceEventType {
  VIEW // alguien abrió el anuncio del servicio
  PROFILE_VISIT // alguien hizo click en "Ver perfil" del proveedor
  REQUEST // alguien envió una solicitud de servicio
}

model ServiceEvent {
  id        String           @id @default(uuid())
  serviceId String
  service   Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type      ServiceEventType
  viewerId  String? // usuario autenticado que generó el evento (opcional)
  createdAt DateTime         @default(now())

  @@index([serviceId])
  @@index([serviceId, type])
  @@index([createdAt(sort: Desc)])
  @@map("service_events")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     LogLevel @default(INFO)
  message   String
  context   String?
  stack     String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt(sort: Desc)])
  @@map("system_logs")
}

// ─── Reportes de usuario (problemas con pedidos, servicios, o la app) ────────

enum ReportEntityType {
  CATALOG_ORDER
  SERVICE_REQUEST
  SERVICE
  ORDER
  GENERAL
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id          String           @id @default(uuid())
  entityType  ReportEntityType
  entityId    String? // null cuando entityType = GENERAL
  reason      String
  description String?
  status      ReportStatus     @default(PENDING)
  adminNotes  String?
  reporterId  String
  reporter    User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([entityType, entityId])
  @@index([status])
  @@index([reporterId])
  @@index([createdAt(sort: Desc)])
  @@map("reports")
}

// ─── Plans & Subscriptions ────────────────────────────────────────────────────

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  PENDING
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model Plan {
  id          String     @id @default(uuid())
  name        String
  description String?
  price       Float
  priceAnnual Float? // descuento anual (opcional)
  status      PlanStatus @default(ACTIVE)
  isPopular   Boolean    @default(false)
  color       String     @default("#3B82F6")
  sortOrder   Int        @default(0)

  // Targets
  forCommerce   Boolean @default(true)
  forFreelancer Boolean @default(false)
  forNormal     Boolean @default(false) // Planes para usuarios NORMAL

  // Categorías de negocio asociadas (para filtrado en onboarding)
  categoryIds String[] @default([])

  // Límites (-1 = ilimitado)
  maxProducts        Int @default(50)
  maxEmployees       Int @default(5)
  maxBranches        Int @default(1)
  maxOrders          Int @default(-1) // por mes
  maxStorage         Int @default(1) // GB
  maxServices        Int @default(-1) // servicios ACTIVOS simultáneos (freelancer)
  maxServiceRequests Int @default(-1) // solicitudes recibidas por mes (freelancer)

  // Features habilitadas (bullets de marketing)
  features Json @default("[]") // string[]

  // Módulos habilitados — valores coinciden con Permission.module del seed
  enabledModules String[] @default([])

  subscriptions Subscription[]
  feeOverrides  PlatformFeeOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id       String             @id @default(uuid())
  userId   String
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status   SubscriptionStatus @default(ACTIVE)
  interval BillingInterval    @default(MONTHLY)

  startAt   DateTime  @default(now())
  endAt     DateTime?
  trialEnds DateTime?

  // Snapshot del precio al momento de suscribirse
  pricePaid Float @default(0)

  // Quién asignó (superadmin o auto)
  assignedBy String? // userId del admin

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

// ─── Platform Fees ────────────────────────────────────────────────────────────

enum FeeTransactionType {
  ORDER
  SERVICE_REQUEST
  RIDE
}

enum FeePayer {
  CLIENT // se suma al total que paga el cliente
  PROVIDER // se descuenta de lo que recibe el proveedor/comercio/conductor (vía Wallet)
}

// Tasa global por tipo de transacción, gestionada por SUPERADMIN.
model PlatformFeeRate {
  id          String             @id @default(uuid())
  type        FeeTransactionType
  rate        Float // porcentaje, ej. 10 = 10%
  payer       FeePayer
  isActive    Boolean            @default(true)
  updatedById String? // SUPERADMIN que hizo el cambio

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@map("platform_fee_rates")
}

// Override opcional por plan o por usuario específico. Prioridad de resolución:
// override por userId > override por planId > PlatformFeeRate global.
model PlatformFeeOverride {
  id       String             @id @default(uuid())
  type     FeeTransactionType
  rate     Float
  payer    FeePayer? // null = hereda el payer del rate global
  planId   String?
  plan     Plan?              @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, userId])
  @@index([type, planId])
  @@map("platform_fee_overrides")
}

// ─── Auth Tokens ─────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─── Rides ────────────────────────────────────────────────────────────────────

enum RideStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RideVehicleType {
  MOTORCYCLE
  CAR
  PICKUP_TRUCK
  TRUCK
}

enum RideServiceType {
  PASSENGER
  FREIGHT
}

model Ride {
  id                String          @id @default(uuid())
  serviceType       RideServiceType @default(PASSENGER)
  origin            String
  destination       String
  originLat         Float?
  originLng         Float?
  destinationLat    Float?
  destinationLng    Float?
  status            RideStatus      @default(PENDING)
  vehicleType       RideVehicleType @default(MOTORCYCLE)
  price             Float?
  distance          Float?
  duration          Int? // minutes
  platformFeeRate   Float?
  platformFeeAmount Float?
  platformFeePayer  FeePayer?
  notes             String?
  // Datos de flete (carga/paquete) — solo aplican cuando serviceType = FREIGHT
  recipientName     String?
  recipientPhone    String?
  cargoDescription  String?
  cargoWeight       Float? // kg aproximados
  declaredValue     Float? // valor declarado de la carga para responsabilidad
  acceptedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?

  passengerId String
  passenger   User    @relation("RidePassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      User?   @relation("RideDriver", fields: [driverId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@index([serviceType])
  @@map("rides")
}

// ─── Exchange Rates ───────────────────────────────────────────────────────────

model ExchangeRate {
  id        String  @id @default(uuid())
  code      String  @unique // e.g. "VES", "COP", "EUR"
  name      String // e.g. "Bolívar Venezolano"
  symbol    String // e.g. "Bs.", "COP", "€"
  rateToUsd Float // how many units of this currency equal 1 USD
  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // only one can be default
  source    String? // e.g. "BCV", "Paralelo", "Manual"
  notes     String?
  updatedBy String? // userId of last editor

  // Auto-sync tracking fields
  autoSync     Boolean   @default(false) // enable auto-sync for this currency
  lastSyncAt   DateTime? // last successful sync timestamp
  syncSource   String? // actual source used: "BCV_SCRAPING", "BCV_API", "MANUAL"
  syncError    String? // last sync error message if failed
  syncAttempts Int       @default(0) // consecutive failed attempts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history ExchangeRateHistory[]

  @@map("exchange_rates")
}

model ExchangeRateHistory {
  id             String       @id @default(uuid())
  exchangeRateId String
  exchangeRate   ExchangeRate @relation(fields: [exchangeRateId], references: [id], onDelete: Cascade)
  code           String // denormalizado: sigue siendo legible si se elimina la moneda
  previousRate   Float? // null en el alta inicial
  newRate        Float
  source         String // "MANUAL" | "BCV_SCRAPING" | "API_FALLBACK" | "CREATE"
  changedBy      String? // userId si fue manual; null si fue automático (cron)
  createdAt      DateTime     @default(now())

  @@index([exchangeRateId])
  @@index([createdAt(sort: Desc)])
  @@map("exchange_rate_history")
}

// ─── Jobs / Empleos ───────────────────────────────────────────────────────────

enum JobType {
  FULL_TIME
  PART_TIME
  FREELANCE
  TEMPORARY
  INTERNSHIP
}

enum JobModality {
  IN_PERSON
  REMOTE
  HYBRID
}

enum JobStatus {
  ACTIVE
  INACTIVE
  PAUSED
  CLOSED
}

enum JobApplicationStatus {
  PENDING
  SEEN
  IN_PROGRESS
  ACCEPTED
  REJECTED
}

model JobCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String   @default("#10B981")
  icon        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]

  @@map("job_categories")
}

model Job {
  id              String      @id @default(uuid())
  title           String
  description     String
  requirements    String[]
  benefits        String[]
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String      @default("USD")
  location        String?
  type            JobType     @default(FULL_TIME)
  modality        JobModality @default(IN_PERSON)
  experienceLevel String? // Junior, Mid, Senior, etc.
  tags            String[]
  status          JobStatus   @default(ACTIVE)
