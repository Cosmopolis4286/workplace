  lastSyncAt   DateTime? // last successful sync timestamp
  syncSource   String? // actual source used: "BCV_SCRAPING", "BCV_API", "MANUAL"
  syncError    String? // last sync error message if failed
  syncAttempts Int       @default(0) // consecutive failed attempts

