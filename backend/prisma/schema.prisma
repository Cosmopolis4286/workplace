generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username          String?  @unique
  usernameUpdatedAt DateTime?
  password  String
  firstName String
  lastName  String
  phone     String?
  birthDate DateTime?
  sex       Sex?
  avatar      String?
  coverImage  String?
  role        Role     @default(NORMAL)
  userType    UserType @default(REGULAR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country       String?
  state         String?
  city          String?

  categoryId    String?
  subcategoryId String?
  category      UserCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory   UserSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  emailVerified   Boolean  @default(false)

  // Denormalizado para checks rápidos en guards (sin join); la fuente de
  // verdad detallada vive en IdentityVerification.
  kycStatus       KycStatus @default(NONE)
  identityVerifications IdentityVerification[]

  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?

  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorEnabledAt   DateTime?
  twoFactorBackupCodes TwoFactorBackupCode[]

  commerce        Restaurant?
  profileSettings ProfileSettings?
  refreshTokens   RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  subscriptions   Subscription[]
  posts           Post[]
  postLikes       PostLike[]    @relation("PostLikes")
  postComments    PostComment[] @relation("PostComments")
  following       Follow[]      @relation("UserFollowing")
  followers       Follow[]      @relation("UserFollowers")
  reviewsGiven    Review[]      @relation("ReviewsGiven")
  reviewsReceived Review[]      @relation("ReviewsReceived")
  services         Service[]
  catalogOrders    CatalogOrder[]
  serviceRequests  ServiceRequest[]
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  wallet           Wallet?
  walletTransactions WalletTransaction[]
  userPermissions  UserPermission[]
  corridasAsPassenger Corrida[]     @relation("PassengerCorridas")
  corridasAsDriver    Corrida[]     @relation("DriverCorridas")

  // Jobs / Empleos
  jobsPosted         Job[]           @relation("UserJobs")
  jobApplications    JobApplication[]

  @@map("users")
}

// ─── Profile Settings ─────────────────────────────────────────────────────────

model ProfileSettings {
  id     String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  showCatalog  Boolean @default(true)
  showServices Boolean @default(true)

  quickAccessIds String[] @default([])
  dashboardQuickActionIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile_settings")
}

// ─── User Categories ──────────────────────────────────────────────────────────

model UserCategory {
  id             String            @id @default(uuid())
  name           String            @unique
  icon           String?
  allowedModules String[]          @default([]) // módulos habilitados para esta categoría de negocio
  subcategories  UserSubcategory[]
  users          User[]

  @@map("user_categories")
}

model UserSubcategory {
  id         String       @id @default(uuid())
  name       String
  categoryId String
  category   UserCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users      User[]

  @@unique([name, categoryId])
  @@map("user_subcategories")
}

model Restaurant {
  id      String  @id @default(uuid())
  name    String
  type    String?
  address String?
  phone   String?
  email   String?
  schedule String?

  country   String?
  state     String?
  city      String?

  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories Category[]
  products   Product[]
  customers     Customer[]
  appointments  Appointment[]
  settings      RestaurantSettings?
  drivers           Driver[]
  deliveries        Delivery[]
  orders            Order[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  notifications     Notification[]
  employees         Employee[]
  branches          Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurants")
}

model RestaurantSettings {
  id           String @id @default(uuid())
  commerceId String @unique
  commerce   Restaurant @relation(fields: [commerceId], references: [id], onDelete: Cascade)

  // Payment
  currency     String  @default("MXN")
  tax          Float   @default(16)
  suggestedTip Float   @default(10)
  paymentMethods String[] @default(["cash", "card", "transfer"])

  // Operations
  avgPrepTime          Int   @default(20)
  avgDeliveryTime      Int   @default(30)
  deliveryFee          Float @default(35)
  freeDeliveryMinimum  Float @default(200)

  // Notifications
  notifyNewOrders      Boolean @default(true)
  notifyLowStock       Boolean @default(true)
  notifyDailyReports   Boolean @default(false)
  notifyCustomerReviews Boolean @default(true)

  // Modules: self-service opt-out — modules included in the plan that the
  // commerce itself chose to hide from its own sidebar (does not grant access
  // beyond the plan, only restricts further).
  disabledModules String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurant_settings")
}

model Customer {
  id              String          @id @default(uuid())
  name            String
  email           String?
  phone           String?
  address         String?
  notes           String?
  segment         CustomerSegment @default(NUEVO)
  totalOrders     Int             @default(0)
  totalSpent      Float           @default(0)
  isActive        Boolean         @default(true)
  telegramChatId  String?
  commerceId      String
  commerce        Restaurant      @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  orders          Order[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([email, commerceId])
  @@map("customers")
}

model Appointment {
  id           String            @id @default(uuid())
  customerName String
  customerPhone String?
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date         DateTime
  partySize    Int               @default(1)
  tableNumber  Int?
  notes        String?
  status       AppointmentStatus @default(PENDIENTE)
  commerceId String
  commerce   Restaurant        @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("appointments")
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  SENTADA
  COMPLETADA
  CANCELADA
  NO_SHOW
}

enum CustomerSegment {
  VIP
  PREMIUM
  REGULAR
  NUEVO
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  // Nuevos campos para sistema robusto
  revokedAt DateTime?  // Cuando se revoca (logout)
  replacedByTokenId String?  // Si fue reemplazado por refresh
  deviceInfo String?   // Info del dispositivo (opcional)
  ipAddress  String?   // IP de creación (opcional)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  description  String?
  icon         String?
  color        String    @default("#6b7280")
  sortOrder    Int       @default(0)
  
  // Categoría global (opcional) - solo si es global
  isGlobal     Boolean   @default(false)
  
  // Categoría de comercio específico (opcional) - solo si es de un comercio
  commerceId   String?
  commerce     Restaurant? @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  
  products     Product[]
  subcategories Subcategory[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([name, commerceId])
  @@unique([name, isGlobal]) // Solo una categoría global con el mismo nombre
  @@map("categories")
}

model Subcategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, categoryId])
  @@map("subcategories")
}

model Product {
  id              String        @id @default(uuid())
  name            String
  description     String?
  price           Float
  cost            Float         @default(0)
  stock           Int           @default(0)
  minStock        Int           @default(5)
  maxStock        Int           @default(100)
  unit            String        @default("unidad")
  status          ProductStatus @default(DISPONIBLE)
  image           String?
  preparationTime Int?
  calories        Int?
  ingredients     String[]
  allergens       String[]
  brand           String?
  forSale         Boolean       @default(true)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId   String?
  subcategory     Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  commerceId    String
  commerce      Restaurant    @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("products")
}

enum Role {
  SUPERADMIN
  ADMIN
  COMMERCE
  FREELANCER
  NORMAL
}

enum UserType {
  APP      // Usuarios propios de la app (superadmin, admins del sistema)
  DEMO     // Cuentas de demostración/test visibles en login
  TEST     // Cuentas de testing automatizado (no visibles)
  REGULAR  // Usuarios normales registrados
}

enum Sex {
  MASCULINO
  FEMENINO
  OTRO
}

enum ProductStatus {
  DISPONIBLE
  AGOTADO
  BAJO_STOCK
  NO_DISPONIBLE
}

// ─── Delivery ────────────────────────────────────────────────────────────────

enum DriverStatus {
  DISPONIBLE
  EN_ENTREGA
  DESCANSO
  INACTIVO
}

enum VehicleType {
  MOTO
  BICICLETA
  BICICLETA_ELECTRICA
  CARRO
  SCOOTER
  A_PIE
}

enum DeliveryStatus {
  PENDIENTE
  ASIGNADO
  RECOGIENDO
  EN_CAMINO
  ENTREGADO
  CANCELADO
  FALLIDO
}

model Driver {
  id           String       @id @default(uuid())
  name         String
  phone        String?
  vehicleType  VehicleType  @default(MOTO)
  vehiclePlate String?
  vehicleModel String?
  status       DriverStatus @default(DISPONIBLE)
  isActive     Boolean      @default(true)
  rating       Float        @default(5.0)
  totalDeliveries Int       @default(0)
  commerceId String
  commerce   Restaurant   @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  deliveries   Delivery[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("drivers")
}

model Delivery {
  id              String         @id @default(uuid())
  orderNumber     String
  customerName    String
  customerPhone   String?
  deliveryAddress String
  notes           String?
  total           Float
  deliveryFee     Float          @default(0)
  status          DeliveryStatus @default(PENDIENTE)
  estimatedTime   Int?           // minutes
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  commerceId    String
  commerce      Restaurant     @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("deliveries")
}

// ─── Orders (Cliente Dashboard) ──────────────────────────────────────────────

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  LISTO
  EN_ENTREGA
  ENTREGADO
  CANCELADO
}

enum OrderType {
  INMEDIATO
  PROGRAMADO
  PARA_LLEVAR
  EN_SITIO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  EN_LINEA
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  REEMBOLSADO
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerName    String
  customerPhone   String?
  customerEmail   String?
  deliveryAddress String?
  notes           String?
  status          OrderStatus   @default(PENDIENTE)
  orderType       OrderType     @default(INMEDIATO)
  paymentMethod   PaymentMethod @default(EFECTIVO)
  paymentStatus   PaymentStatus @default(PENDIENTE)
  subtotal        Float         @default(0)
  tax             Float         @default(0)
  deliveryFee     Float         @default(0)
  discount        Float         @default(0)
  total           Float
  scheduledAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  commerceId    String
  commerce      Restaurant    @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  quantity    Int      @default(1)
  unitPrice   Float
  subtotal    Float
  notes       String?
  createdAt   DateTime @default(now())

  @@map("order_items")
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationType {
  ORDER
  DELIVERY
  INVENTORY
  APPOINTMENT
  EXPENSE
  SYSTEM
}

model Notification {
  id           String           @id @default(uuid())
  type         NotificationType @default(SYSTEM)
  title        String
  message      String
  read         Boolean          @default(false)
  readAt       DateTime?
  icon         String           @default("BellIcon")
  color        String           @default("gray")
  link         String?
  metadata     Json?
  commerceId String?
  commerce   Restaurant?      @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@index([commerceId, createdAt(sort: Desc)])
  @@index([commerceId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@map("notifications")
}

// ─── Expenses ────────────────────────────────────────────────────────────────

// Digital Wallets

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum KycStatus {
  NONE       // nunca envió una solicitud
  PENDING    // documentos enviados, esperando revisión
  APPROVED
  REJECTED
}

enum KycDocumentType {
  CEDULA
  DNI
  PASSPORT
  DRIVERS_LICENSE
}

model IdentityVerification {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType   KycDocumentType
  documentNumber String
  fullName       String        // nombre legal tal como aparece en el documento
  birthDate      DateTime?

  frontImageUrl  String
  backImageUrl   String?
  selfieImageUrl String

  status         KycStatus     @default(PENDING)
  rejectionReason String?

  reviewedBy     String?       // userId del admin que aprobó/rechazó
  reviewedAt     DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)])
  @@map("identity_verifications")
}

model Wallet {
  id       String       @id @default(uuid())
  userId   String       @unique
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency String       @default("USD")
  balance  Float        @default(0)
  status   WalletStatus @default(ACTIVE)

  pin      String?      // bcrypt hash of 6-digit PIN
  pinSetAt DateTime?

  frozenAt   DateTime?  // set when admin freezes; null = not frozen
  frozenBy   String?    // userId of admin who froze

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("wallets")
}

model WalletTransaction {
  id           String                  @id @default(uuid())
  walletId     String
  wallet       Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         WalletTransactionType
  status       WalletTransactionStatus @default(COMPLETED)
  amount       Float
  balanceAfter Float
  description  String?
  reference    String?
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([reference])
  @@map("wallet_transactions")
}

enum ExpenseType {
  FIJO
  OPERATIVO
  EXTRAORDINARIO
}

enum ExpenseStatus {
  PENDIENTE
  PAGADO
  VENCIDO
  CANCELADO
}

enum ExpensePaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
}

model ExpenseCategory {
  id           String    @id @default(uuid())
  name         String
  color        String    @default("#6b7280")
  budget       Float     @default(0)
  commerceId String
  commerce   Restaurant @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([name, commerceId])
  @@map("expense_categories")
}

model Expense {
  id            String               @id @default(uuid())
  description   String
  amount        Float
  date          DateTime
  type          ExpenseType          @default(OPERATIVO)
  status        ExpenseStatus        @default(PENDIENTE)
  paymentMethod ExpensePaymentMethod @default(EFECTIVO)
  supplier      String?
  receipt       String?
  notes         String?
  categoryId    String?
  category      ExpenseCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  commerceId  String
  commerce    Restaurant           @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@map("expenses")
}

// ─── Employees ────────────────────────────────────────────────────────────────

enum EmployeeRole {
  GERENTE
  SUPERVISOR
  COCINERO
  MESERO
  CAJERO
  REPARTIDOR
  LIMPIEZA
  SEGURIDAD
  OTRO
}

enum EmployeeStatus {
  ACTIVO
  INACTIVO
  VACACIONES
  LICENCIA
  SUSPENDIDO
}

model Employee {
  id               String         @id @default(uuid())
  firstName        String
  lastName         String
  email            String?
  phone            String?
  role             EmployeeRole   @default(OTRO)
  status           EmployeeStatus @default(ACTIVO)
  salary           Float?
  hireDate         DateTime?
  birthDate        DateTime?
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?
  isActive         Boolean        @default(true)
  commerceId     String
  commerce       Restaurant     @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([email, commerceId])
  @@map("employees")
}

// ─── Branches ─────────────────────────────────────────────────────────────────

enum BranchStatus {
  ACTIVA
  INACTIVA
  EN_CONSTRUCCION
  CERRADA
}

model Branch {
  id           String       @id @default(uuid())
  name         String
  address      String?
  phone        String?
  email        String?
  type         String?
  managerName  String?
  managerPhone String?
  status       BranchStatus @default(ACTIVA)
  color        String       @default("#6b7280")
  notes        String?
  commerceId String
  commerce   Restaurant   @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([name, commerceId])
  @@map("branches")
}

// ─── Social / Profiles ────────────────────────────────────────────────────────

enum PostMediaType {
  IMAGE
  VIDEO
}

model Post {
  id            String        @id @default(uuid())
  caption       String?
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  likes         PostLike[]
  comments      PostComment[]
  likesCount    Int           @default(0)
  commentsCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PostComments", fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt(sort: Asc)])
  @@map("post_comments")
}

model PostMedia {
  id     String        @id @default(uuid())
  postId String
  post   Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  url    String
  type   PostMediaType @default(IMAGE)
  order  Int           @default(0)

  @@map("post_media")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

enum ReviewReportStatus {
  PENDIENTE
  REVISADO
  DESCARTADO
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  authorId  String
  author    User     @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  // Verificación de transacción real: referencia a la orden/solicitud que habilitó la reseña
  verifiedOrderId   String?
  verifiedRequestId String?

  // Respuesta pública del negocio/freelancer reseñado
  response    String?
  respondedAt DateTime?

  // Moderación
  isHidden Boolean  @default(false)
  reports  ReviewReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, targetId])
  @@index([targetId])
  @@index([targetId, isHidden])
  @@map("reviews")
}

model ReviewReport {
  id         String             @id @default(uuid())
  reviewId   String
  review     Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String
  status     ReviewReportStatus @default(PENDIENTE)
  createdAt  DateTime           @default(now())

  @@index([reviewId])
  @@index([status])
  @@map("review_reports")
}

// ─── Permission Matrix ────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  action      String
  label       String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  updatedAt    DateTime   @updatedAt
  updatedBy    String?

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// Permisos individuales por usuario (sobrescriben los del rol)
model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true) // true = concedido, false = denegado explícitamente
  reason       String?    // Razón de la asignación especial
  expiresAt    DateTime?  // Expiración opcional
  updatedAt    DateTime   @updatedAt
  updatedBy    String?

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

// Global kill-switch: when a module is disabled here, it disappears from
// EVERY user's sidebar regardless of role, plan, or category — including
// SUPERADMIN. Intended for maintenance windows / staged rollouts, not RBAC.
model SystemModule {
  id        String   @id @default(uuid())
  module    String   @unique
  enabled   Boolean  @default(true)
  label     String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_modules")
}

// ─── Audit & Logs ─────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  UPLOAD
  EXPORT
  VIEW
  OTHER
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  userEmail  String?
  userRole   String?
  action     AuditAction @default(OTHER)
  module     String
  entityId   String?
  summary    String
  details    Json?
  ip         String?
  userAgent  String?
  statusCode Int?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

enum LogLevel {
  ERROR
  WARN
  INFO
  DEBUG
}

// ─── Catalog Order Request (marketplace) ─────────────────────────────────────

enum CatalogDeliveryType {
  DOMICILIO
  RECOGER
  DIGITAL
}

enum CatalogOrderStatus {
  PENDIENTE
  VISTO
  CONTACTADO
  CERRADO
}

model CatalogOrder {
  id               String              @id @default(uuid())
  productId        String
  productName      String
  commerceId     String
  restaurantName   String
  quantity         Int                 @default(1)
  deliveryType     CatalogDeliveryType @default(DOMICILIO)
  address          String?
  city             String?
  buyerName        String
  buyerPhone       String
  buyerEmail       String?
  notes            String?
  totalEstimate    Float?
  status           CatalogOrderStatus  @default(PENDIENTE)
  requesterId      String?
  requester        User?               @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())

  @@index([commerceId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("catalog_orders")
}

// ─── Services (marketplace) ───────────────────────────────────────────────────

enum ServiceStatus {
  ACTIVO
  INACTIVO
  PAUSADO
}

model ServiceCategory {
  id           String    @id @default(uuid())
  name         String
  color        String    @default("#3B82F6")
  icon         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  services     Service[]

  @@map("service_categories")
}

model ServiceModality {
  id        String   @id @default(uuid())
  name      String   @unique
  value     String   @unique
  emoji     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_modalities")
}

model Service {
  id           String          @id @default(uuid())
  name         String
  description  String?
  price        Float
  priceUnit    String?
  duration     Int?            // minutos estimados
  image        String?
  status       ServiceStatus   @default(ACTIVO)
  tags         String[]
  modalities   String[]
  categoryId   String?
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("services")
  serviceRequests ServiceRequest[]
  serviceEvents   ServiceEvent[]
}

enum ServiceRequestStatus {
  PENDIENTE
  VISTO
  CONTACTADO
  CERRADO
}

enum ServiceRequestModality {
  PRESENCIAL
  REMOTO
  CUALQUIERA
}

model ServiceRequest {
  id           String                 @id @default(uuid())
  serviceId    String
  service      Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceName  String
  providerId   String
  providerName String
  modality     ServiceRequestModality @default(CUALQUIERA)
  preferredDate DateTime
  address      String?
  city         String?
  clientName   String
  clientPhone  String
  clientEmail  String?
  description  String?
  price        Float?
  priceUnit    String?
  status           ServiceRequestStatus   @default(PENDIENTE)
  providerNotes    String?
  statusUpdatedAt  DateTime?
  requesterId  String?
  requester    User?                  @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([serviceId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("service_requests")
}

enum ServiceEventType {
  VIEW           // alguien abrió el anuncio del servicio
  PROFILE_VISIT  // alguien hizo click en "Ver perfil" del proveedor
  REQUEST        // alguien envió una solicitud de servicio
}

model ServiceEvent {
  id        String           @id @default(uuid())
  serviceId String
  service   Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type      ServiceEventType
  viewerId  String?          // usuario autenticado que generó el evento (opcional)
  createdAt DateTime         @default(now())

  @@index([serviceId])
  @@index([serviceId, type])
  @@index([createdAt(sort: Desc)])
  @@map("service_events")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     LogLevel @default(INFO)
  message   String
  context   String?
  stack     String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt(sort: Desc)])
  @@map("system_logs")
}

// ─── Plans & Subscriptions ────────────────────────────────────────────────────

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  PENDING
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model Plan {
  id          String     @id @default(uuid())
  name        String
  description String?
  price       Float
  priceAnnual Float?     // descuento anual (opcional)
  status      PlanStatus @default(ACTIVE)
  isPopular   Boolean    @default(false)
  color       String     @default("#3B82F6")
  sortOrder   Int        @default(0)

  // Targets
  forCommerce   Boolean @default(true)
  forFreelancer Boolean @default(false)
  forNormal     Boolean @default(false) // Planes para usuarios NORMAL

  // Categorías de negocio asociadas (para filtrado en onboarding)
  categoryIds String[] @default([])

  // Límites (-1 = ilimitado)
  maxProducts   Int @default(50)
  maxEmployees  Int @default(5)
  maxBranches   Int @default(1)
  maxOrders     Int @default(-1) // por mes
  maxStorage    Int @default(1)  // GB

  // Features habilitadas (bullets de marketing)
  features Json @default("[]") // string[]

  // Módulos habilitados — valores coinciden con Permission.module del seed
  enabledModules String[] @default([])

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id       String             @id @default(uuid())
  userId   String
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status   SubscriptionStatus @default(ACTIVE)
  interval BillingInterval    @default(MONTHLY)

  startAt   DateTime  @default(now())
  endAt     DateTime?
  trialEnds DateTime?

  // Snapshot del precio al momento de suscribirse
  pricePaid Float @default(0)

  // Quién asignó (superadmin o auto)
  assignedBy String? // userId del admin

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

// ─── Auth Tokens ─────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─── Corridas (Rides) ─────────────────────────────────────────────────────────

enum CorridaStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CorridaVehicleType {
  MOTO
  AUTO
}

model Corrida {
  id             String             @id @default(uuid())
  origin         String
  destination    String
  originLat      Float?
  originLng      Float?
  destinationLat Float?
  destinationLng Float?
  status         CorridaStatus      @default(PENDING)
  vehicleType    CorridaVehicleType @default(MOTO)
  price          Float?
  distance       Float?
  duration       Int?               // minutes
  notes          String?
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?

  passengerId    String
  passenger      User               @relation("PassengerCorridas", fields: [passengerId], references: [id], onDelete: Cascade)
  driverId       String?
  driver         User?              @relation("DriverCorridas", fields: [driverId], references: [id], onDelete: SetNull)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@map("corridas")
}

// ─── Exchange Rates ───────────────────────────────────────────────────────────

model ExchangeRate {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. "VES", "COP", "EUR"
  name         String   // e.g. "Bolívar Venezolano"
  symbol       String   // e.g. "Bs.", "COP", "€"
  rateToUsd    Float    // how many units of this currency equal 1 USD
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false) // only one can be default
  source       String?  // e.g. "BCV", "Paralelo", "Manual"
  notes        String?
  updatedBy    String?  // userId of last editor

  // Auto-sync tracking fields
  autoSync      Boolean  @default(false) // enable auto-sync for this currency
  lastSyncAt    DateTime? // last successful sync timestamp
  syncSource    String?  // actual source used: "BCV_SCRAPING", "BCV_API", "MANUAL"
  syncError     String?  // last sync error message if failed
  syncAttempts  Int      @default(0) // consecutive failed attempts

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  history ExchangeRateHistory[]

  @@map("exchange_rates")
}

model ExchangeRateHistory {
  id             String       @id @default(uuid())
  exchangeRateId String
  exchangeRate   ExchangeRate @relation(fields: [exchangeRateId], references: [id], onDelete: Cascade)
  code           String       // denormalizado: sigue siendo legible si se elimina la moneda
  previousRate   Float?       // null en el alta inicial
  newRate        Float
  source         String       // "MANUAL" | "BCV_SCRAPING" | "API_FALLBACK" | "CREATE"
  changedBy      String?      // userId si fue manual; null si fue automático (cron)
  createdAt      DateTime     @default(now())

  @@index([exchangeRateId])
  @@index([createdAt(sort: Desc)])
  @@map("exchange_rate_history")
}

// ─── Jobs / Empleos ───────────────────────────────────────────────────────────

enum JobType {
  TIEMPO_COMPLETO
  MEDIO_TIEMPO
  FREELANCE
  TEMPORAL
  PRACTICAS
}

enum JobModality {
  PRESENCIAL
  REMOTO
  HIBRIDO
}

enum JobStatus {
  ACTIVO
  INACTIVO
  PAUSADO
  CERRADO
}

enum JobApplicationStatus {
  PENDIENTE
  VISTO
  EN_PROCESO
  ACEPTADA
  RECHAZADA
}

model JobCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String   @default("#10B981")
  icon        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]

  @@map("job_categories")
}

model Job {
  id              String      @id @default(uuid())
  title           String
  description     String
  requirements    String[]
  benefits        String[]
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String      @default("USD")
  location        String?
  type            JobType     @default(TIEMPO_COMPLETO)
  modality        JobModality @default(PRESENCIAL)
  experienceLevel String?     // Junior, Mid, Senior, etc.
  tags            String[]
  status          JobStatus   @default(ACTIVO)
  expiresAt       DateTime?

  // Relations
  categoryId    String?
  category        JobCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  employerId      String
  employer        User         @relation("UserJobs", fields: [employerId], references: [id], onDelete: Cascade)

  // For commerce users
  commerceId      String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  applications    JobApplication[]

  @@index([employerId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([modality])
  @@index([createdAt(sort: Desc)])
  @@map("jobs")
}

model JobApplication {
  id          String                @id @default(uuid())
  jobId       String
  job         Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User                  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverLetter String?
  resumeUrl   String?
  phone       String?
  email       String?
  status      JobApplicationStatus  @default(PENDIENTE)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([jobId])
  @@index([applicantId])
  @@index([status])
  @@unique([jobId, applicantId])
  @@map("job_applications")
}

// ─── Search Tabs Configuration ───────────────────────────────────────────────

model SearchTab {
  id        String   @id @default(uuid())
  key       String   @unique  // "productos" | "servicios" | "empleos" | custom
  label     String
  icon      String?           // SVG path string or icon name
  color     String   @default("#EF4444")
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("search_tabs")
}

// ─── Push Notification Device Tokens ─────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(uuid())
  token     String   @unique
  platform  String   // "android" | "ios" | "web"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

// ─── Landing Content ──────────────────────────────────────────────────────────

model LandingTestimonial {
  id          String   @id @default(uuid())
  quote       String
  name        String
  role        String
  initials    String   @default("")
  avatarColor String   @default("#EF4444")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  // Si se origina en una reseña real verificada, queda enlazada aquí (auditable, no editable)
  sourceReviewId String? @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_testimonials")
}

model LandingStat {
  id        String   @id @default(uuid())
  key       String   @unique // "restaurants" | "uptime" | "orders" | "rating" | "support"
  label     String
  value     String   // valor display, ej: "500+" o se calcula dinámicamente
  isDynamic Boolean  @default(false) // true = se calcula desde la BD en cada request
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("landing_stats")
}

model LandingFeature {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   // nombre del componente Heroicons, ej: "ShoppingCartIcon"
  bg          String   @default("bg-blue-500") // clase Tailwind del fondo del ícono
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_features")
}

model LandingStep {
  id        String   @id @default(uuid())
  title     String
  desc      String
  icon      String   // nombre del componente Heroicons, ej: "UserPlusIcon"
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("landing_steps")
}

// ─── Wallets & Transactions ─────────────────────────────────────────────────────
