generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String?  @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  avatar    String?
  role      Role     @default(NORMAL)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant?
  refreshTokens RefreshToken[]

  @@map("users")
}

model Restaurant {
  id      String  @id @default(uuid())
  name    String
  type    String?
  address String?
  phone   String?
  email   String?
  schedule String?

  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories Category[]
  products   Product[]
  customers     Customer[]
  appointments  Appointment[]
  settings      RestaurantSettings?
  drivers           Driver[]
  deliveries        Delivery[]
  orders            Order[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  notifications     Notification[]
  employees         Employee[]
  branches          Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurants")
}

model RestaurantSettings {
  id           String @id @default(uuid())
  restaurantId String @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Payment
  currency     String  @default("MXN")
  tax          Float   @default(16)
  suggestedTip Float   @default(10)
  paymentMethods String[] @default(["cash", "card", "transfer"])

  // Operations
  avgPrepTime          Int   @default(20)
  avgDeliveryTime      Int   @default(30)
  deliveryFee          Float @default(35)
  freeDeliveryMinimum  Float @default(200)

  // Notifications
  notifyNewOrders      Boolean @default(true)
  notifyLowStock       Boolean @default(true)
  notifyDailyReports   Boolean @default(false)
  notifyCustomerReviews Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurant_settings")
}

model Customer {
  id           String          @id @default(uuid())
  name         String
  email        String?
  phone        String?
  address      String?
  notes        String?
  segment      CustomerSegment @default(NUEVO)
  totalOrders  Int             @default(0)
  totalSpent   Float           @default(0)
  isActive     Boolean         @default(true)
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  orders       Order[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([email, restaurantId])
  @@map("customers")
}

model Appointment {
  id           String            @id @default(uuid())
  customerName String
  customerPhone String?
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date         DateTime
  partySize    Int               @default(1)
  tableNumber  Int?
  notes        String?
  status       AppointmentStatus @default(PENDIENTE)
  restaurantId String
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("appointments")
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  SENTADA
  COMPLETADA
  CANCELADA
  NO_SHOW
}

enum CustomerSegment {
  VIP
  PREMIUM
  REGULAR
  NUEVO
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  color        String    @default("#6b7280")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([name, restaurantId])
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid())
  name            String
  description     String?
  price           Float
  cost            Float         @default(0)
  stock           Int           @default(0)
  minStock        Int           @default(5)
  maxStock        Int           @default(100)
  unit            String        @default("unidad")
  status          ProductStatus @default(DISPONIBLE)
  image           String?
  preparationTime Int?
  calories        Int?
  ingredients     String[]
  allergens       String[]
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  restaurantId    String
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("products")
}

enum Role {
  SUPERADMIN
  ADMIN
  COMMERCE
  FREELANCER
  NORMAL
}

enum ProductStatus {
  DISPONIBLE
  AGOTADO
  BAJO_STOCK
  NO_DISPONIBLE
}

// ─── Delivery ────────────────────────────────────────────────────────────────

enum DriverStatus {
  DISPONIBLE
  EN_ENTREGA
  DESCANSO
  INACTIVO
}

enum VehicleType {
  MOTO
  BICICLETA
  BICICLETA_ELECTRICA
  CARRO
  SCOOTER
  A_PIE
}

enum DeliveryStatus {
  PENDIENTE
  ASIGNADO
  RECOGIENDO
  EN_CAMINO
  ENTREGADO
  CANCELADO
  FALLIDO
}

model Driver {
  id           String       @id @default(uuid())
  name         String
  phone        String?
  vehicleType  VehicleType  @default(MOTO)
  vehiclePlate String?
  vehicleModel String?
  status       DriverStatus @default(DISPONIBLE)
  isActive     Boolean      @default(true)
  rating       Float        @default(5.0)
  totalDeliveries Int       @default(0)
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deliveries   Delivery[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("drivers")
}

model Delivery {
  id              String         @id @default(uuid())
  orderNumber     String
  customerName    String
  customerPhone   String?
  deliveryAddress String
  notes           String?
  total           Float
  deliveryFee     Float          @default(0)
  status          DeliveryStatus @default(PENDIENTE)
  estimatedTime   Int?           // minutes
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  restaurantId    String
  restaurant      Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("deliveries")
}

// ─── Orders (Cliente Dashboard) ──────────────────────────────────────────────

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  LISTO
  EN_ENTREGA
  ENTREGADO
  CANCELADO
}

enum OrderType {
  INMEDIATO
  PROGRAMADO
  PARA_LLEVAR
  EN_SITIO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  EN_LINEA
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  REEMBOLSADO
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerName    String
  customerPhone   String?
  customerEmail   String?
  deliveryAddress String?
  notes           String?
  status          OrderStatus   @default(PENDIENTE)
  orderType       OrderType     @default(INMEDIATO)
  paymentMethod   PaymentMethod @default(EFECTIVO)
  paymentStatus   PaymentStatus @default(PENDIENTE)
  subtotal        Float         @default(0)
  tax             Float         @default(0)
  deliveryFee     Float         @default(0)
  discount        Float         @default(0)
  total           Float
  scheduledAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  restaurantId    String
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  quantity    Int      @default(1)
  unitPrice   Float
  subtotal    Float
  notes       String?
  createdAt   DateTime @default(now())

  @@map("order_items")
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationType {
  ORDER
  DELIVERY
  INVENTORY
  APPOINTMENT
  EXPENSE
  SYSTEM
}

model Notification {
  id           String           @id @default(uuid())
  type         NotificationType @default(SYSTEM)
  title        String
  message      String
  read         Boolean          @default(false)
  readAt       DateTime?
  icon         String           @default("BellIcon")
  color        String           @default("gray")
  link         String?
  metadata     Json?
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([restaurantId, read])
  @@map("notifications")
}

// ─── Expenses ────────────────────────────────────────────────────────────────

enum ExpenseType {
  FIJO
  OPERATIVO
  EXTRAORDINARIO
}

enum ExpenseStatus {
  PENDIENTE
  PAGADO
  VENCIDO
  CANCELADO
}

enum ExpensePaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
}

model ExpenseCategory {
  id           String    @id @default(uuid())
  name         String
  color        String    @default("#6b7280")
  budget       Float     @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([name, restaurantId])
  @@map("expense_categories")
}

model Expense {
  id            String               @id @default(uuid())
  description   String
  amount        Float
  date          DateTime
  type          ExpenseType          @default(OPERATIVO)
  status        ExpenseStatus        @default(PENDIENTE)
  paymentMethod ExpensePaymentMethod @default(EFECTIVO)
  supplier      String?
  receipt       String?
  notes         String?
  categoryId    String?
  category      ExpenseCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  restaurantId  String
  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@map("expenses")
}

// ─── Employees ────────────────────────────────────────────────────────────────

enum EmployeeRole {
  GERENTE
  SUPERVISOR
  COCINERO
  MESERO
  CAJERO
  REPARTIDOR
  LIMPIEZA
  SEGURIDAD
  OTRO
}

enum EmployeeStatus {
  ACTIVO
  INACTIVO
  VACACIONES
  LICENCIA
  SUSPENDIDO
}

model Employee {
  id               String         @id @default(uuid())
  firstName        String
  lastName         String
  email            String?
  phone            String?
  role             EmployeeRole   @default(OTRO)
  status           EmployeeStatus @default(ACTIVO)
  salary           Float?
  hireDate         DateTime?
  birthDate        DateTime?
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?
  isActive         Boolean        @default(true)
  restaurantId     String
  restaurant       Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([email, restaurantId])
  @@map("employees")
}

// ─── Branches ─────────────────────────────────────────────────────────────────

enum BranchStatus {
  ACTIVA
  INACTIVA
  EN_CONSTRUCCION
  CERRADA
}

model Branch {
  id           String       @id @default(uuid())
  name         String
  address      String?
  phone        String?
  email        String?
  type         String?
  managerName  String?
  managerPhone String?
  status       BranchStatus @default(ACTIVA)
  color        String       @default("#6b7280")
  notes        String?
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([name, restaurantId])
  @@map("branches")
}

// ─── Permission Matrix ────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  action      String
  label       String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  updatedAt    DateTime   @updatedAt
  updatedBy    String?

  @@unique([role, permissionId])
  @@map("role_permissions")
}
