// ─── Suppliers (proveedores B2B del comercio) ──────────────────────────────────
//
// Cierra el hueco de "Proveedores" del MVP de Commerce (ver diagnóstico
// WORKPLACE_STATUS_FEEDBACK.md). v1 deliberadamente simple: solo el
// directorio de contactos del comercio, sin SupplierOrder (compra B2B) ni
// vínculo al ecosistema — Expense.supplier sigue siendo texto libre, no se
// migra a esta entidad todavía (ese vínculo es un paso futuro, no bloqueante).

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id              String           @id @default(uuid())
  name            String
  contactName     String?
  phone           String?
  email           String?
  address         String?
  category        String?
  notes           String?
  status          SupplierStatus   @default(ACTIVE)
  commerceId      String
  commerce        Commerce         @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  purchases       Purchase[]
  quotes          SupplierQuote[]
  accountPayables AccountPayable[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([name, commerceId])
  @@index([commerceId])
  @@map("suppliers")
}

// Precio OFERTADO por un proveedor para un producto — a diferencia de
// Purchase (lo que realmente se compró), esto permite comparar proveedores
// ANTES de comprarles. Ver WORKPLACE_VISION.md sección 12 (Supplier
// Intelligence): "Proveedor A es 4% más barato, pero tarda 6 días más" /
// "Proveedor B aumentó este producto 12% en 14 días" requieren tener el
// historial de cotizaciones, no solo de compras concretadas.
model SupplierQuote {
  id         String   @id @default(uuid())
  commerceId String
  commerce   Commerce @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  price        Float
  currencyCode String

  // Snapshot inmutable de la tasa usada para el equivalente en USD, mismo
  // criterio que Purchase.exchangeRateValue — no se recalcula si la tasa
  // cambia después.
  exchangeRateValue Float
  priceUsd          Float

  // Días estimados de entrega desde que se confirma el pedido — permite el
  // trade-off "más barato pero más lento" de la sección 12.
  leadTimeDays Int?
  available    Boolean @default(true)
  notes        String?

  quotedAt  DateTime @default(now())
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commerceId, productId, quotedAt(sort: Desc)])
  @@index([supplierId])
  @@map("supplier_quotes")
}

// Compra de inventario a un proveedor. Es la fuente de datos para el costo
// de reposición (Business Shield, ver WORKPLACE_VISION.md) — sin este
// registro no hay forma de distinguir "cuánto costó históricamente" de
// "cuánto costaría reponer hoy". La tasa de cambio se guarda como snapshot
// inmutable (no solo el FK a ExchangeRate) porque la tasa real cambia
// después y el historial de esta compra no debe cambiar retroactivamente.
model Purchase {
  id         String    @id @default(uuid())
  commerceId String
  commerce   Commerce  @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  quantity Int
  // Costo unitario en la moneda original de la compra (currencyCode).
  unitCost Float

  // Moneda en la que se pactó/pagó esta compra (código de ExchangeRate, ej. "USD", "VES").
  currencyCode       String
  // Snapshot inmutable de la tasa usada para calcular el equivalente en USD
  // al momento de la compra — NO se recalcula si la tasa cambia después.
  exchangeRateValue  Float
  exchangeRateSource String? // "BCV_SCRAPING" | "MANUAL" | etc., informativo

  // unitCost convertido a USD usando exchangeRateValue, para poder comparar
  // compras hechas en distintas monedas/fechas sin reconvertir en cada query.
  unitCostUsd Float

  purchasedAt DateTime @default(now())
  notes       String?

  accountPayable AccountPayable?

  createdBy String? // userId de quien registró la compra
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commerceId, productId, purchasedAt(sort: Desc)])
  @@index([supplierId])
  @@map("purchases")
}

enum AccountStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// Dinero que el comercio TIENE que cobrar (venta fiado/a crédito a un
// cliente). Ver WORKPLACE_VISION.md sección 11: vender fiado en un contexto
// de inflación puede destruir valor si el cobro se demora — este modelo
// guarda el snapshot de tasa al momento de la venta para poder comparar
// contra la tasa actual al momento de cobrar (ver
// AccountsService.getReplacementRisk). No reemplaza Order.paymentStatus
// (que es "¿ya procesé el pago de esta orden?", operativo) — esto es
// crédito explícito con vencimiento y riesgo de poder adquisitivo.
model AccountReceivable {
  id         String    @id @default(uuid())
  commerceId String
  commerce   Commerce  @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId    String?   @unique
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  description       String
  amount            Float
  currencyCode      String
  // Snapshot inmutable de la tasa a USD en el momento de LA VENTA — se
  // compara contra la tasa actual al cobrar para medir exposición cambiaria.
  exchangeRateValue Float
  amountUsd         Float

  dueDate DateTime?
  status  AccountStatus @default(PENDING)
  paidAt  DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commerceId, status, dueDate])
  @@index([customerId])
  @@map("account_receivables")
}

// Dinero que el comercio TIENE que pagar (compra a crédito a un
// proveedor) — el espejo de AccountReceivable. Mismo criterio de snapshot
// de tasa de cambio.
model AccountPayable {
  id         String    @id @default(uuid())
  commerceId String
  commerce   Commerce  @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseId String?   @unique
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  description       String
  amount            Float
  currencyCode      String
  exchangeRateValue Float
  amountUsd         Float

  dueDate DateTime?
  status  AccountStatus @default(PENDING)
  paidAt  DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commerceId, status, dueDate])
  @@index([supplierId])
  @@map("account_payables")
}

// ─── Social / Profiles ────────────────────────────────────────────────────────

enum PostMediaType {
  IMAGE
  VIDEO
}

model Post {
  id            String        @id @default(uuid())
