// ─── Catálogo de división territorial de Venezuela ──────────────────────────────

enum VeLocationType {
  MUNICIPIO
  CIUDAD
  PARROQUIA
}

// Jerarquía Municipio → Ciudad → Parroquia vía self-relation. El nivel
// "Estado" no se modela aquí: ya lo resuelve country-state-city en el
// frontend (24 estados de Venezuela correctos); stateName solo ancla
// el Municipio raíz al nombre de ese estado.
model VeLocation {
  id         String         @id @default(uuid())
  type       VeLocationType
  name       String
  stateName  String? // solo en type=MUNICIPIO
  postalCode String? // solo relevante en type=PARROQUIA
  parentId   String?
  parent     VeLocation?    @relation("VeLocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   VeLocation[]   @relation("VeLocationHierarchy")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // stateName se incluye en la unique key porque algunos nombres de
  // Municipio se repiten entre estados distintos (ej. "Sucre" existe como
  // municipio en Miranda y en Sucre) — sin esto, ambos colisionarían ya que
  // parentId es null para todos los Municipios.
  @@unique([name, parentId, type, stateName])
  @@index([parentId])
  @@index([stateName])
  @@map("ve_locations")
}

// ─── Reputation Score ─────────────────────────────────────────────────────────
//
// Proyección de solo lectura, recalculada por ReputationService a partir de
// transacciones ya validadas (Order/ServiceRequest/Delivery/Report) — nunca
// escrita directo por un endpoint público. Mismo patrón que
// Commerce.avgRating (ver ProfilesService.recalculateCommerceRating): una
// fila por entidad, sobreescrita en cada evento relevante, no acumulada
// como histórico.

enum ReputationEntityType {
  COMMERCE
  PROFESSIONAL
  DRIVER
}

model ReputationScore {
  id         String               @id @default(uuid())
  entityType ReputationEntityType
  // Commerce.id | User.id (profesional) | Driver.id según entityType
  entityId   String

  // 0-100 redondeado — lo único que se expone hoy en UI pública.
  score Int

  // Desglose auditable de la fórmula (completionRate, cancellationRate,
  // punctualityRate, disputeRate) — no se expone crudo en UI pública todavía,
  // para no facilitar optimizar exactamente el mínimo por componente.
  breakdown Json

  // Denominador de confianza: cuántas operaciones sostienen este score. Todo
  // consumidor (UI, matching, AI agent) debe tratar sampleSize bajo como
  // "todavía sin suficiente historial", nunca como 0/100 real.
  sampleSize Int

  calculatedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, score])
  @@map("reputation_scores")
}

// ─── Wallets & Transactions ─────────────────────────────────────────────────────
