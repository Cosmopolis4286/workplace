  description   String
  amount        Float
  date          DateTime
  type          ExpenseType          @default(OPERATIONAL)
  status        ExpenseStatus        @default(PENDING)
  paymentMethod ExpensePaymentMethod @default(CASH)
  supplier      String?
  receipt       String?
  notes         String?
  categoryId    String?
  category      ExpenseCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  commerceId    String
  commerce      Commerce             @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([commerceId])
  @@index([categoryId])
  @@map("expenses")
}

// ─── Cash register (caja) ──────────────────────────────────────────────────────

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  INCOME
  WITHDRAWAL
}

model CashSession {
  id             String            @id @default(uuid())
  status         CashSessionStatus @default(OPEN)
  openingAmount  Float
  openedAt       DateTime          @default(now())
  openedBy       String
  notes          String?
  countedAmount  Float?
  expectedAmount Float?
  difference     Float?
  closedAt       DateTime?
  closedBy       String?
  closingNotes   String?
  movements      CashMovement[]
  commerceId     String
  commerce       Commerce          @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Solo puede existir una sesión OPEN a la vez por comercio. Prisma no
  // soporta índices únicos parciales en su DSL, así que la garantía real es
  // un índice único parcial agregado a mano en la migración
  // unique_open_cash_session_per_commerce (SQL crudo, WHERE status='OPEN').
  // CashService.open() igual chequea antes de crear, solo para devolver un
  // 409 legible en el caso común — el índice es lo que evita la carrera.
  @@index([commerceId])
  @@map("cash_sessions")
}

model CashMovement {
  id         String           @id @default(uuid())
  type       CashMovementType
  amount     Float
  reason     String
  sessionId  String
  session    CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  commerceId String
  commerce   Commerce         @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@index([sessionId])
  @@index([commerceId])
  @@map("cash_movements")
}

// ─── Employees ────────────────────────────────────────────────────────────────

enum EmployeeRole {
  MANAGER
  SUPERVISOR
  COOK
  WAITER
  CASHIER
  DELIVERY_PERSON
  CLEANING
  SECURITY
  OTHER
