generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  username          String?   @unique
  usernameUpdatedAt DateTime?
  password          String
  firstName         String
  lastName          String
  phone             String?
  birthDate         DateTime?
  sex               Sex?
  avatar            String?
  coverImage        String?
  role              Role      @default(NORMAL)
  userType          UserType  @default(REGULAR)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  country      String?
  state        String?
  city         String?
  municipality String?
  parish       String?

  categoryId    String?
  subcategoryId String?
  category      UserCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory   UserSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  emailVerified Boolean @default(false)

  // Denormalizado para checks rápidos en guards (sin join); la fuente de
  // verdad detallada vive en IdentityVerification.
  kycStatus             KycStatus              @default(NONE)
  identityVerifications IdentityVerification[]

  proposedCategories         ProposedCategory[] @relation("ProposedCategoryProposer")
  reviewedProposedCategories ProposedCategory[] @relation("ProposedCategoryReviewer")

  freelancerApplications         FreelancerApplication[] @relation("FreelancerApplicant")
  reviewedFreelancerApplications FreelancerApplication[] @relation("FreelancerApplicationReviewer")

  walletDepositRequests         WalletDepositRequest[] @relation("WalletDepositRequester")
  reviewedWalletDepositRequests WalletDepositRequest[] @relation("WalletDepositRequestReviewer")

  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?

  twoFactorEnabled     Boolean               @default(false)
  twoFactorSecret      String?
  twoFactorEnabledAt   DateTime?
  twoFactorBackupCodes TwoFactorBackupCode[]

  // Trial de 7 días autoservicio (activable una sola vez en la vida de la
  // cuenta, en cualquier momento mientras esté en un plan gratuito). null =
  // todavía no lo usó. Se marca al activar, nunca se resetea.
  trialUsedAt DateTime?

  commerce                Commerce?
  profileSettings         ProfileSettings?
  freelancerSettings      FreelancerSettings?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  subscriptions           Subscription[]
  featureGrants           FeatureGrant[]
  feeOverrides            PlatformFeeOverride[]
  posts                   Post[]
  postLikes               PostLike[]               @relation("PostLikes")
  postComments            PostComment[]            @relation("PostComments")
  following               Follow[]                 @relation("UserFollowing")
  followers               Follow[]                 @relation("UserFollowers")
  reviewsGiven            Review[]                 @relation("ReviewsGiven")
  reviewsReceived         Review[]                 @relation("ReviewsReceived")
  services                Service[]
  catalogOrders           CatalogOrder[]
  serviceRequests         ServiceRequest[]
  serviceRequestMessages  ServiceRequestMessage[]
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  wallet                  Wallet?
  walletTransactions      WalletTransaction[]
  userPermissions         UserPermission[]
  ridesAsPassenger        Ride[]                   @relation("RidePassenger")
  ridesAsDriver           Ride[]                   @relation("RideDriver")
  reportsFiled            Report[]
  driverProfile           Driver?
  deliveriesAsCustomer    Delivery[]
  profiles                UserProfile[]
  reviewedProfiles        UserProfile[]            @relation("UserProfileReviewer")

  // Contexto de UX activo ("estoy usando WorkPlace como..."). Puramente
  // presentacional: NO participa en permisos ni capacidades — esas siguen
  // siendo la unión de TODOS los UserProfile ACTIVE, no solo este. Null =
  // sin preferencia explícita; el frontend infiere el default con la misma
  // prioridad que AccountTypeResolver (BUSINESS > PROFESSIONAL > JOB_SEEKER
  // > CUSTOMER). SetNull: si el perfil activo se borra/rechaza, no debe
  // arrastrar al User con un FK colgante.
  activeProfileId String?
  activeProfile   UserProfile? @relation("ActiveProfile", fields: [activeProfileId], references: [id], onDelete: SetNull)

  // Jobs / Empleos
  jobsPosted      Job[]            @relation("UserJobs")
  jobApplications JobApplication[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@map("users")
}

// ─── Profile Settings ─────────────────────────────────────────────────────────

model ProfileSettings {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  showCatalog  Boolean @default(true)
  showServices Boolean @default(true)

  quickAccessIds          String[] @default([])
  dashboardQuickActionIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile_settings")
}

// ─── User Categories ──────────────────────────────────────────────────────────

model UserCategory {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  icon                   String?
  allowedModules         String[]                @default([]) // módulos habilitados para esta categoría de negocio
  subcategories          UserSubcategory[]
  users                  User[]
  freelancerApplications FreelancerApplication[]
  profileActivations     UserProfile[]

  @@map("user_categories")
}

model UserSubcategory {
  id                     String                  @id @default(uuid())
  name                   String
  categoryId             String
  category               UserCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users                  User[]
  freelancerApplications FreelancerApplication[]
  profileActivations     UserProfile[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("user_subcategories")
}

// Un comercio de cualquier rubro (restaurante, tienda, farmacia, etc.) — el
// nombre del modelo era Restaurant por legado histórico del proyecto
// (originalmente solo restaurantes); `type` ya distingue el rubro y ningún
// campo es específico de comida, así que se renombró a Commerce para
// reflejar lo que el dato ya representaba.
model Commerce {
  id       String  @id @default(uuid())
  name     String
  type     String?
  address  String?
  phone    String?
  email    String?
  schedule String?

  country      String?
  state        String?
  city         String?
  municipality String?
  parish       String?

  // Cache desnormalizado de reviews.aggregate(targetId: user.id, isHidden: false).
  // Recalculado en ProfilesService cada vez que una review del dueño del
  // comercio se crea/edita/oculta/restaura — permite ORDER BY nativo en
  // Postgres en vez de traer todo el catálogo a memoria para ordenar por rating.
  avgRating    Float?
  reviewsCount Int    @default(0)

  // URL pública de la tienda (/loja/:slug), independiente del username del
  // dueño — ver User.username para el mismo patrón (regex, cooldown de 30
  // días). Nullable: comercios existentes no tienen slug hasta que lo eligen.
  slug          String?   @unique
  slugUpdatedAt DateTime?

  // Contenido de la página pública de la tienda (/loja/:slug).
  description String?
  // Permite ocultar la tienda pública sin afectar el resto de la app (el
  // comercio sigue operando en dashboard/catálogo interno). Default true:
  // comercios existentes no deben desaparecer de /loja al desplegar esto.
  isPublic    Boolean @default(true)
  // Estructura libre {instagram, facebook, whatsapp, tiktok, ...} — evita una
  // tabla nueva para algo que no se consulta ni se filtra, solo se muestra.
  socialLinks Json?

  userId             String                 @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Vínculo al perfil BUSINESS del dueño (ver UserProfile). Nullable y
  // desacoplado de `userId` a propósito: `userId` sigue siendo la FK real que
  // usan ~15 servicios vía `commerce.findUnique({ where: { userId } })` — no
  // se toca para no romper esos call sites. `profileId` es aditivo, para que
  // el modelo de "perfiles múltiples" (ver WORKPLACE_VISION.md) pueda
  // construirse encima sin migrar esa FK todavía.
  profileId          String?                @unique
  profile            UserProfile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  categories         Category[]
  products           Product[]
  customers          Customer[]
  appointments       Appointment[]
  settings           CommerceSettings?
  drivers            Driver[]
  deliveries         Delivery[]
  orders             Order[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  notifications      Notification[]
  employees          Employee[]
  branches           Branch[]
  suppliers          Supplier[]
  purchases          Purchase[]
  accountReceivables AccountReceivable[]
  accountPayables    AccountPayable[]
  stockSnapshots     ProductStockSnapshot[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  receipts           Receipt[]
  bnplSettings       BnplSettings[]
  bnplTransactions   BnplTransaction[]
  driverInvitations  DriverInvitation[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  SupplierQuote SupplierQuote[]

  @@index([avgRating])
  @@index([slug])
  @@map("commerces")
}

// ─── User Profiles (perfiles múltiples) ────────────────────────────────────
//
// Ver WORKPLACE_VISION.md, sección "Estado actual vs. visión". Un User puede
// tener varias filas activas acá simultáneamente (CUSTOMER + PROFESSIONAL,
// PROFESSIONAL + BUSINESS, etc.) — a diferencia de `accountType` en User, que
// es un enum excluyente y queda intacto por compatibilidad hacia atrás.
//
// Este modelo NO reemplaza `Commerce.userId` ni `FreelancerApplication`
// todavía: es aditivo. `Commerce.profileId` (nullable) es el único punto de
// unión hoy, para no tener que migrar los ~15 call sites que resuelven
// commerce vía `where: { userId }`. BUSINESS y PROFESSIONAL requieren
// aprobación (mismo flujo que ya usaba FreelancerApplication); CUSTOMER y
// JOB_SEEKER se activan sin revisión.
model UserProfile {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    ProfileType
  subtype ProfessionalSubtype?
  status  ProfileStatus        @default(ACTIVE)

  // Solo aplica a PROFESSIONAL/BUSINESS (mismo dato que FreelancerApplication
  // pedía). Al aprobar, se copia a User.categoryId/subcategoryId — ver
  // ProfileActivationsService.review().
  categoryId    String?
  subcategoryId String?
  category      UserCategory?    @relation(fields: [categoryId], references: [id])
  subcategory   UserSubcategory? @relation(fields: [subcategoryId], references: [id])

  // Solo aplica a type=BUSINESS: nombre elegido por el solicitante al pedir
  // el perfil, antes de que exista el Commerce. Al aprobar, review() crea el
  // Commerce con este nombre (ver ProfileActivationsService.review()) — sin
  // esto, un usuario aprobado quedaba sin Commerce real hasta que por
  // casualidad tocara /menu (el único call site con auto-creación).
  pendingCommerceName String?

  // Solo aplica a PROFESSIONAL/BUSINESS: plan elegido por el solicitante al
  // pedir el perfil, antes de existir un Commerce/Subscription. Al aprobar,
  // review() activa (o crea) la Subscription correspondiente con este plan
  // — mismo dato que antes se perdía al pasar por /plans/upgrade sin dejar
  // rastro en UserProfile.
  // onDelete: SetNull (no Restrict, a diferencia de Subscription.plan) —
  // esta referencia es solo una intención mientras la solicitud está
  // PENDING, no debe bloquear el borrado de un Plan por una fila que aún
  // no se materializó en una Subscription real.
  pendingPlanId       String?
  pendingPlan         Plan?            @relation(fields: [pendingPlanId], references: [id], onDelete: SetNull)
  pendingPlanInterval BillingInterval?

  rejectionReason String?
  reviewedBy      String?
  reviewer        User?     @relation("UserProfileReviewer", fields: [reviewedBy], references: [id])
  reviewedAt      DateTime?

  commerce Commerce?

  // Inverso de User.activeProfileId — usuarios que tienen ESTE perfil
  // marcado como su contexto de UX activo (0 o 1 en la práctica, ya que es
  // 1:1 conceptualmente, pero Prisma requiere la lista en el lado sin FK).
  activeForUsers User[] @relation("ActiveProfile")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No hay @@unique([userId, type]): un usuario puede tener un REJECTED
  // histórico y luego una fila PENDING/ACTIVE nueva del mismo tipo. La regla
  // "no más de un PENDING/ACTIVE simultáneo por tipo" se aplica en el
  // service (mismo patrón que FreelancerApplication.create), no en el schema.
  @@index([userId])
  @@index([status])
  @@index([type, status])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([pendingPlanId])
  @@map("user_profiles")
}

enum ProfileType {
  CUSTOMER
  PROFESSIONAL
  JOB_SEEKER
  BUSINESS
}

enum ProfessionalSubtype {
  FREELANCER
  SERVICE_PROVIDER
}

enum ProfileStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model CommerceSettings {
  id         String   @id @default(uuid())
  commerceId String   @unique
  commerce   Commerce @relation(fields: [commerceId], references: [id], onDelete: Cascade)

  // Payment
  currency       String   @default("MXN")
  tax            Float    @default(16)
  suggestedTip   Float    @default(10)
  paymentMethods String[] @default(["cash", "card", "transfer"])

  // Price Guard (Business Shield, ver WORKPLACE_VISION.md sección 6) — margen
  // objetivo y mínimo por defecto para todos los productos del comercio.
  // targetMarginPct es informativo (referencia para el comerciante);
  // minMarginPct es el que efectivamente calcula el precio mínimo
  // recomendado. Product.minMarginPct puede sobreescribir este default
  // producto por producto.
  targetMarginPct Float @default(30)
  minMarginPct    Float @default(15)

  // Operations
  avgPrepTime         Int   @default(20)
  avgDeliveryTime     Int   @default(30)
  deliveryFee         Float @default(35)
  freeDeliveryMinimum Float @default(200)

  // Notifications
  notifyNewOrders       Boolean @default(true)
  notifyLowStock        Boolean @default(true)
  notifyDailyReports    Boolean @default(false)
  notifyCustomerReviews Boolean @default(true)

  // Modules: self-service opt-out — modules included in the plan that the
  // commerce itself chose to hide from its own sidebar (does not grant access
  // beyond the plan, only restricts further).
  disabledModules String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commerce_settings")
}

// Settings de un FREELANCER (proveedor de servicios independiente). Separado
// de CommerceSettings porque un freelancer no tiene Commerce ni opera
// con conceptos de comercio físico (tax, delivery, avgPrepTime, etc.) — solo
// moneda de pago, notificaciones relevantes a ServiceRequest, y módulos.
model FreelancerSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nombre público con el que se identifica profesionalmente (ej. "Juan Pérez
  // Diseño"), distinto de User.firstName/lastName. Nullable: si no lo define,
  // el resto de la app sigue usando firstName+lastName como hoy.
  professionalName String?

  // URL pública del perfil profesional (/pro/:slug), independiente del
  // username del usuario (ver User.username) y del slug de tienda de
  // Commerce (ver Commerce.slug) — mismo patrón (regex, cooldown de 30 días)
  // pero con su propio namespace: un freelancer puede querer una marca
  // profesional distinta de su username de red social.
  slug          String?   @unique
  slugUpdatedAt DateTime?

  // Payment
  currency String @default("USD")

  // Notifications
  notifyNewRequests     Boolean @default(true)
  notifyRequestUpdates  Boolean @default(true)
  notifyDailyReports    Boolean @default(false)
  notifyCustomerReviews Boolean @default(true)

  // Modules: self-service opt-out, igual semántica que CommerceSettings.disabledModules
  disabledModules String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("freelancer_settings")
}

model Customer {
  id                 String              @id @default(uuid())
  name               String
  email              String?
  phone              String?
  address            String?
  notes              String?
  segment            CustomerSegment     @default(NEW)
  totalOrders        Int                 @default(0)
  totalSpent         Float               @default(0)
  isActive           Boolean             @default(true)
  telegramChatId     String?
  commerceId         String
  commerce           Commerce            @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  orders             Order[]
  accountReceivables AccountReceivable[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([email, commerceId])
  @@index([commerceId])
  @@map("customers")
}

model Appointment {
  id            String            @id @default(uuid())
  customerName  String
  customerPhone String?
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date          DateTime
  partySize     Int               @default(1)
  tableNumber   Int?
  notes         String?
  status        AppointmentStatus @default(PENDING)
  commerceId    String
  commerce      Commerce          @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([commerceId])
  @@index([customerId])
  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CustomerSegment {
  VIP
  PREMIUM
  REGULAR
  NEW
}

model RefreshToken {
  id        String   @id @default(uuid())
  /// SHA-256 hex del refresh token JWT — nunca el token crudo (ver
  /// common/utils/crypto.util.ts#hashToken). Un dump de esta tabla no debe
  /// permitir reconstruir sesiones válidas.
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Nuevos campos para sistema robusto
  revokedAt         DateTime? // Cuando se revoca (logout)
  replacedByTokenId String? // Si fue reemplazado por refresh
  deviceInfo        String? // Info del dispositivo (opcional)
  ipAddress         String? // IP de creación (opcional)
  /// jti del par access/refresh token, guardado en claro porque ya NO es
  /// posible decodificarlo desde `token` (que ahora es un hash) — se usa
  /// para blacklistear el access token asociado en logout/revokeSession.
  jti               String?

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?
  icon        String?
  color       String  @default("#6b7280")
  sortOrder   Int     @default(0)

  // Categoría global (opcional) - solo si es global
  isGlobal Boolean @default(false)

  // Categoría de comercio específico (opcional) - solo si es de un comercio
  commerceId String?
  commerce   Commerce? @relation(fields: [commerceId], references: [id], onDelete: Cascade)

  products      Product[]
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([name, commerceId])
  @@unique([name, isGlobal]) // Solo una categoría global con el mismo nombre
  @@index([commerceId])
  @@map("categories")
}

model Subcategory {
  id          String  @id @default(uuid())
  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("subcategories")
}

model Product {
  id              String              @id @default(uuid())
  name            String
  description     String?
  price           Float
  cost            Float               @default(0)
  stock           Int                 @default(0)
  minStock        Int                 @default(5)
  maxStock        Int                 @default(100)
  unit            String              @default("unidad")
  status          ProductStatus       @default(AVAILABLE)
  image           String?
  preparationTime Int?
  calories        Int?
  ingredients     String[]
  allergens       String[]
  tags            String[]
  brand           String?
  forSale         Boolean             @default(true)
  bnplEligible    Boolean             @default(true)
  // Override de CommerceSettings.minMarginPct para este producto específico
  // (Price Guard, ver WORKPLACE_VISION.md sección 6). null = usa el default
  // del comercio.
  minMarginPct    Float?
  // Cache desnormalizado de la suma de CatalogOrder.quantity para este
  // producto. Incrementado en CatalogService.createOrder — permite ORDER BY
  // nativo en Postgres para "más vendidos" en vez de un groupBy + sort en memoria.
  salesCount      Int                 @default(0)
  // Pack de varios productos del mismo comercio vendido como una sola unidad
  // (ver ProductBundleItem). stock/cost en un bundle no se usan — el stock
  // real vive en los componentes y se descuenta de ahí al vender el pack.
  isBundle        Boolean             @default(false)
  bundleItems     ProductBundleItem[] @relation("BundleComponents")
  partOfBundles   ProductBundleItem[] @relation("ComponentOf")
  purchases       Purchase[]
  supplierQuotes  SupplierQuote[]
  categoryId      String
  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId   String?
  subcategory     Subcategory?        @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  commerceId      String
  commerce        Commerce            @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, forSale, salesCount])
  @@index([commerceId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@map("products")
}

// Componentes de un Product con isBundle=true. bundleProductId es el pack,
// componentProductId es cada producto real que lo integra — el stock del
// pack se resuelve siempre vía sus componentes (ver CatalogService.createOrder).
model ProductBundleItem {
  id                 String  @id @default(uuid())
  bundleProductId    String
  bundleProduct      Product @relation("BundleComponents", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentProductId String
  // Restrict: no se puede borrar un producto mientras siga siendo componente
  // de un pack activo — evita packs con referencias colgantes.
  componentProduct   Product @relation("ComponentOf", fields: [componentProductId], references: [id], onDelete: Restrict)
  quantity           Int     @default(1)

  @@unique([bundleProductId, componentProductId])
  @@index([componentProductId])
  @@map("product_bundle_items")
}

// Snapshot diario del conteo de productos en LOW_STOCK por comercio.
// El stock es mutable y no versionado, así que esto es lo único que permite
// graficar una tendencia real en vez de recalcular un historial inexistente.
model ProductStockSnapshot {
  id            String   @id @default(uuid())
  commerceId    String
  commerce      Commerce @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  lowStockCount Int
  date          DateTime @db.Date
  createdAt     DateTime @default(now())

  @@unique([commerceId, date])
  @@index([commerceId, date])
  @@map("product_stock_snapshots")
}

// COMMERCE/FREELANCER se fusionaron en PROFESIONAL (2026-08-25): Role es
// solo nivel de acceso RBAC, no identidad de negocio. La distinción real
// "tiene Commerce vs es freelancer/service provider" vive en UserProfile.
// type (BUSINESS vs PROFESSIONAL/subtype) — ver RoleResolverService y
// ProfilePermission. RolePermission.PROFESIONAL solo lleva la intersección
// de permisos común a ambos; lo específico de cada uno lo aporta
// ProfilePermission según el UserProfile activo real.
enum Role {
  SUPERADMIN
  ADMIN
  PROFESIONAL
  NORMAL
}

enum UserType {
  APP // Usuarios propios de la app (superadmin, admins del sistema)
  DEMO // Cuentas de demostración/test visibles en login
  TEST // Cuentas de testing automatizado (no visibles)
  REGULAR // Usuarios normales registrados
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ProductStatus {
  AVAILABLE
  OUT_OF_STOCK
  LOW_STOCK
  UNAVAILABLE
}

// ─── Delivery ────────────────────────────────────────────────────────────────

enum DriverStatus {
  AVAILABLE
  ON_DELIVERY
  ON_BREAK
  INACTIVE
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  ELECTRIC_BICYCLE
  CAR
  SCOOTER
  ON_FOOT
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKING_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

model Driver {
  id              String       @id @default(uuid())
  name            String
  phone           String?
  vehicleType     VehicleType  @default(MOTORCYCLE)
  vehiclePlate    String?
  vehicleModel    String?
  status          DriverStatus @default(AVAILABLE)
  isActive        Boolean      @default(true)
  rating          Float        @default(5.0)
  totalDeliveries Int          @default(0)
  commerceId      String
  commerce        Commerce     @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  deliveries      Delivery[]

  // Cuenta propia del repartidor (con su propio KYC). Nullable: drivers
  // creados antes de este cambio no tienen cuenta todavía — ver `graceUntil`.
  // Una vez vinculado, solo puede recibir asignaciones si user.kycStatus = APPROVED.
  userId              String?   @unique
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Fecha límite para vincularse a una cuenta verificada antes de quedar
  // inactivo para nuevas asignaciones. Null = sin restricción (ya vinculado,
  // o creado ya bajo el régimen nuevo vía invitación).
  graceUntil          DateTime?
  // Evita reenviar el aviso de gracia al comercio más de una vez (ver
  // DriverGraceReminderScheduler). Null = aún no se avisó.
  graceReminderSentAt DateTime?

  // Última posición GPS conocida (no histórico — ver TrackingService, que
  // guarda el histórico corto en Redis con TTL, no en Postgres).
  currentLat        Float?
  currentLng        Float?
  currentHeading    Float?
  currentSpeed      Float?
  locationUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índice parcial adicional sobre (graceUntil) WHERE graceUntil IS NOT NULL
  // AND graceReminderSentAt IS NULL, agregado a mano en la migración init
  // (Prisma DSL no soporta WHERE) — acelera DriverGraceReminderScheduler.
  @@index([commerceId])
  @@map("drivers")
}

enum DriverInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// Invitación que el comercio envía para que un repartidor cree su propia
// cuenta y quede vinculado como Driver verificado (ver Driver.userId).
model DriverInvitation {
  id         String                 @id @default(uuid())
  token      String                 @unique
  commerceId String
  commerce   Commerce               @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  email      String
  phone      String?
  name       String?
  status     DriverInvitationStatus @default(PENDING)
  driverId   String? // Driver resultante, una vez aceptada
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime               @default(now())

  @@index([commerceId])
  @@index([email])
  @@map("driver_invitations")
}

model Delivery {
  id              String         @id @default(uuid())
  orderNumber     String
  customerName    String
  customerPhone   String?
  deliveryAddress String
  notes           String?
  total           Float
  deliveryFee     Float          @default(0)
  status          DeliveryStatus @default(PENDING)
  estimatedTime   Int? // minutes
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  commerceId      String
  commerce        Commerce       @relation(fields: [commerceId], references: [id], onDelete: Cascade)

  // Cliente autenticado dueño de esta entrega, si se conoce (nullable: la
  // mayoría de las entregas hoy se crean manualmente por el comercio desde
  // pedidos por WhatsApp/teléfono, sin usuario de la plataforma asociado).
  // Es el único campo que autoriza a un cliente a suscribirse al tracking en
  // vivo de esta entrega — ver TrackingGateway.
  customerUserId String?
  customerUser   User?   @relation(fields: [customerUserId], references: [id], onDelete: SetNull)

  // Coordenadas de recogida/entrega. Nullable porque `deliveryAddress` sigue
  // siendo el dato canónico (texto libre); las coordenadas son necesarias
  // solo para poder trazar ruta/mapa/ETA y pueden faltar en entregas viejas
  // o cargadas sin geocodificar.
  pickupLat Float?
  pickupLng Float?
  destLat   Float?
  destLng   Float?

  // Se activa mientras el estado permite transmitir GPS en vivo (ver
  // TrackingService.syncTrackingActive) y se apaga al finalizar/cancelar —
  // corta la emisión WS y evita exponer ubicación fuera de ese período.
  trackingActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commerceId])
  @@index([driverId])
  @@index([customerUserId])
  @@map("deliveries")
}

// ─── Orders (Cliente Dashboard) ──────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  IMMEDIATE
  SCHEDULED
  TAKEAWAY
  DINE_IN
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
  CASHEA
  KRECE
}

enum BnplProvider {
  CASHEA
  KRECE
}

enum BnplTransactionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id                String             @id @default(uuid())
  orderNumber       String             @unique
  customerName      String
  customerPhone     String?
  customerEmail     String?
  deliveryAddress   String?
  notes             String?
  status            OrderStatus        @default(PENDING)
  orderType         OrderType          @default(IMMEDIATE)
  paymentMethod     PaymentMethod      @default(CASH)
  paymentStatus     PaymentStatus      @default(PENDING)
  subtotal          Float              @default(0)
  tax               Float              @default(0)
  deliveryFee       Float              @default(0)
  discount          Float              @default(0)
  total             Float
  platformFeeRate   Float?
  platformFeeAmount Float?
  platformFeePayer  FeePayer?
  scheduledAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  customerId        String?
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  commerceId        String
  commerce          Commerce           @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  receipt           Receipt?
  bnplTransaction   BnplTransaction?
  accountReceivable AccountReceivable?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([commerceId])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  quantity    Int      @default(1)
  unitPrice   Float
  subtotal    Float
  notes       String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// Credenciales BNPL (Cashea/Krece) por comercio y por proveedor. Un comercio
// puede tener ambos proveedores configurados simultáneamente.
model BnplSettings {
  id         String       @id @default(uuid())
  commerceId String
  commerce   Commerce     @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  provider   BnplProvider

  isEnabled   Boolean @default(false)
  isSimulated Boolean @default(true)

  // Cifrados con encryptSecret/decryptSecret (AES-256-GCM, ver common/utils/crypto.util.ts)
  publicApiKeyEnc     String?
  privateApiKeyEnc    String?
  storeId             String?
  storeName           String?
  externalClientIdEnc String?
  extraConfig         Json?   @default("{}")

  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([commerceId, provider])
  @@map("bnpl_settings")
}

model BnplTransaction {
  id         String                @id @default(uuid())
  orderId    String                @unique
  order      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  commerceId String
  commerce   Commerce              @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  provider   BnplProvider
  status     BnplTransactionStatus @default(PENDING)

  externalReference String?
  checkoutUrl       String?
  amount            Float
  currency          String  @default("USD")
  installments      Int?

  expiresAt     DateTime?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  failureReason String?

  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commerceId])
  @@index([status])
  @@index([provider, status])
  @@index([status, expiresAt])
  @@map("bnpl_transactions")
}

// ─── Receipts (comprobante de venta, NO es factura fiscal) ─────────────────────
//
// Venezuela exige desde el 20/03/2025 un sistema de facturación HOMOLOGADO por
// el SENIAT (Providencias SNAT/2024/000102 y SNAT/2024/000121: transmisión
// automática al SENIAT, inmutabilidad, registro de IP/MAC/usuario por
// operación) para emitir facturas válidas por medios digitales. Este modelo
// NO implementa eso — es un comprobante de venta interno para el cliente,
// deliberadamente rotulado como no-fiscal en el PDF generado.

model Receipt {
  id              String   @id @default(uuid())
  receiptNumber   String   @unique
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  commerceId      String
  commerce        Commerce @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  // Snapshot de datos del comercio al momento de emitir — si el comercio
  // cambia nombre/dirección después, el comprobante histórico no debe mutar.
  commerceName    String
  commerceAddress String?
  commercePhone   String?
  issuedAt        DateTime @default(now())

  @@index([commerceId])
  @@map("receipts")
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationType {
  ORDER
  DELIVERY
  INVENTORY
  APPOINTMENT
  EXPENSE
  REVIEW
  SYSTEM
}

model Notification {
  id         String           @id @default(uuid())
  type       NotificationType @default(SYSTEM)
  title      String
  message    String
  read       Boolean          @default(false)
  readAt     DateTime?
  icon       String           @default("BellIcon")
  color      String           @default("gray")
  link       String?
  metadata   Json?
  commerceId String?
  commerce   Commerce?        @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@index([commerceId, createdAt(sort: Desc)])
  @@index([commerceId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@map("notifications")
}

// ─── Expenses ────────────────────────────────────────────────────────────────

// Digital Wallets

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum KycStatus {
  NONE // nunca envió una solicitud
  PENDING // documentos enviados, esperando revisión
  APPROVED
  REJECTED
}

enum KycDocumentType {
  CEDULA
  DNI
  PASSPORT
  DRIVERS_LICENSE
}

model IdentityVerification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType   KycDocumentType
  documentNumber String
  fullName       String // nombre legal tal como aparece en el documento
  birthDate      DateTime?

  frontImageUrl  String
  backImageUrl   String?
  selfieImageUrl String

  status          KycStatus @default(PENDING)
  rejectionReason String?

  reviewedBy String? // userId del admin que aprobó/rechazó
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)])
  @@map("identity_verifications")
}

enum ProposedCategoryTarget {
  PRODUCT
  SERVICE
  JOB
  USER_CATEGORY
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProposedCategory {
  id          String                 @id @default(uuid())
  name        String
  description String?
  color       String?
  icon        String?
  target      ProposedCategoryTarget

  // Solo aplica a USER_CATEGORY: si viene con valor, es una propuesta de
  // SUBcategoría bajo esta UserCategory ya existente (el usuario eligió una
  // categoría real pero no encontró su subcategoría). Null = propuesta de
  // categoría raíz nueva.
  parentCategoryId String?

  proposedBy String
  proposer   User   @relation("ProposedCategoryProposer", fields: [proposedBy], references: [id], onDelete: Cascade)

  status          ProposalStatus @default(PENDING)
  rejectionReason String?

  reviewedBy String?
  reviewer   User?     @relation("ProposedCategoryReviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?

  // id de la categoría real creada en Category/ServiceCategory/JobCategory al aprobar
  resultingCategoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([target, status])
  @@index([proposedBy])
  @@index([reviewedBy])
  @@map("proposed_categories")
}

// Solicitud de un usuario NORMAL para convertirse en FREELANCER (proveedor de
// servicios). No hay alta pública de FREELANCER (decisión de producto) — este
// es el único camino self-service, y requiere aprobación de un ADMIN/SUPERADMIN
// antes de que el rol cambie. Un ADMIN también puede seguir asignando el rol
// directamente desde /users sin pasar por acá (sin cambios a ese flujo).
model FreelancerApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("FreelancerApplicant", fields: [userId], references: [id], onDelete: Cascade)

  categoryId    String
  category      UserCategory     @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   UserSubcategory? @relation(fields: [subcategoryId], references: [id])
  message       String? // por qué quiere ofrecer servicios, experiencia, etc.

  status          ProposalStatus @default(PENDING)
  rejectionReason String?

  reviewedBy String?
  reviewer   User?     @relation("FreelancerApplicationReviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId, status])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([reviewedBy])
  @@map("freelancer_applications")
}

// Solicitud de carga de saldo con comprobante externo (transferencia bancaria,
// Zelle, Binance Pay, pago móvil, etc.). deposit() en WalletsService ya no
// acredita saldo directamente desde el endpoint público — solo se acredita al
// aprobar esta solicitud, y ese crédito reutiliza el mismo deposit() interno
// (mismo registro de WalletTransaction, mismos límites de saldo por rol).
model WalletDepositRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("WalletDepositRequester", fields: [userId], references: [id], onDelete: Cascade)

  amount        Float
  paymentMethod String // texto libre: "Transferencia bancaria", "Zelle", "Binance Pay", "Pago móvil"...
  reference     String? // número de referencia/confirmación declarado por el usuario
  proofImageUrl String // comprobante subido (imagen)

  status          ProposalStatus @default(PENDING)
  rejectionReason String?

  reviewedBy String?
  reviewer   User?     @relation("WalletDepositRequestReviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?

  // walletTransactionId de la transacción real creada al aprobar (para auditoría)
  resultingTransactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId, status])
  @@index([reviewedBy])
  @@map("wallet_deposit_requests")
}

model Wallet {
  id       String       @id @default(uuid())
  userId   String       @unique
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency String       @default("USD")
  balance  Float        @default(0)
  status   WalletStatus @default(ACTIVE)

  pin      String? // bcrypt hash of 6-digit PIN
  pinSetAt DateTime?

  frozenAt DateTime? // set when admin freezes; null = not frozen
  frozenBy String? // userId of admin who froze

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("wallets")
}

model WalletTransaction {
  id           String                  @id @default(uuid())
  walletId     String
  wallet       Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         WalletTransactionType
  status       WalletTransactionStatus @default(COMPLETED)
  amount       Float
  balanceAfter Float
  description  String?
  reference    String?
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([reference])
  @@map("wallet_transactions")
}

enum ExpenseType {
  FIXED
  OPERATIONAL
  EXTRAORDINARY
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ExpensePaymentMethod {
  CASH
  TRANSFER
  CARD
  CHECK
}

model ExpenseCategory {
  id         String    @id @default(uuid())
  name       String
  color      String    @default("#6b7280")
