  summary    String
  details    Json?
  ip         String?
  userAgent  String?
  statusCode Int?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

enum LogLevel {
  ERROR
  WARN
  INFO
  DEBUG
}

// ─── Catalog Order Request (marketplace) ─────────────────────────────────────

enum CatalogDeliveryType {
  HOME_DELIVERY
  PICKUP
  DIGITAL
}

enum CatalogOrderStatus {
  PENDING
  SEEN
  CONTACTED
  CLOSED
}

model CatalogOrder {
  id            String              @id @default(uuid())
  commerceId    String
  commerceName  String
  deliveryType  CatalogDeliveryType @default(HOME_DELIVERY)
  address       String?
  city          String?
  buyerName     String
  buyerPhone    String
  buyerEmail    String?
  notes         String?
  totalEstimate Float?
  status        CatalogOrderStatus  @default(PENDING)
  requesterId   String?
  requester     User?               @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  items         CatalogOrderItem[]
  createdAt     DateTime            @default(now())

  @@index([commerceId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([requesterId])
  @@map("catalog_orders")
}

// Línea de pedido: uno o más productos (o un único pack) por CatalogOrder.
// Sin FK a Product (igual que el productId histórico de CatalogOrder): un
// producto borrado no debe romper el historial de pedidos ya realizados.
model CatalogOrderItem {
  id          String       @id @default(uuid())
  orderId     String
  order       CatalogOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
