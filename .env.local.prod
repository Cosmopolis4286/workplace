# =========================
# WORKPLACE - PRODUCCIÓN LOCAL
# =========================
# Configuración de producción para desarrollo local

# =========================
# APP CONFIGURACIÓN
# =========================
APP_NAME=WorkPlace
ENVIRONMENT=production

NODE_PORT=3001           # Puerto interno del backend (Docker)
FRONTEND_PORT=3000       # Puerto interno del frontend (Docker)
NITRO_HOST=0.0.0.0       # IMPORTANTE: Necesario para Docker, escucha en todas las interfaces

# =========================
# NODE MEMORY CONFIGURACIÓN
# =========================
NODE_OPTIONS=--max-old-space-size=512
# Limita el uso de memoria de Node.js a 512MB por contenedor

# =========================
# NGINX CONFIGURACIÓN
# =========================
SSL_ENABLED=true          # Activar SSL para testing local
HTTP_PORT=80            # Puerto HTTP estándar
HTTPS_PORT=443          # Puerto HTTPS estándar

# Certbot Settings
STAGING_MODE=true       # Usar staging para testing local

# =========================
# POSTGRESQL (Docker internal)
# =========================
POSTGRES_USER=workplace
POSTGRES_PASSWORD=9FmK2xN8pL4qR7vT3wS6zY1iG5jB8nE2cV5aI9d=
POSTGRES_DB=workplace_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# =========================
# Redis (Docker internal)
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=7XpQ3rN6mK9sF2tZ5wV8yU1iO4lA7dG0jB3eH6f=

# =========================
# JWT CONFIGURACIÓN (PRODUCCIÓN LOCAL)
# =========================
JWT_SECRET=B+4CUOj1VX6xsGFKzcpbGLqyDBtuZjWOffnNGvRp1H8=
JWT_EXPIRES_IN=15m       # Tiempo expiración access token
JWT_REFRESH_SECRET=TzbxqqNI7GALfT0hkRhLmoEAZ/DVpt2N+REI33TJFqI=
JWT_REFRESH_EXPIRES_IN=7d # Tiempo expiración refresh token

# =========================
# URLs (PRODUCCIÓN LOCAL)
# =========================
DOMAIN=localhost         # Usar localhost para desarrollo local
FRONTEND_URL=http://localhost       # HTTP para testing local
BACKEND_API_URL=/api                 # Proxy nginx

# =========================
# DOCKER CONFIGURACIÓN
# =========================
DOCKER_USER=eiskerhc

# =========================
# GOOGLE OAUTH (OPCIONAL)
