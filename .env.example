# =========================
# WORKPLACE - CONFIGURACIÓN DE ENTORNO
# =========================
# Este archivo es una plantilla para producción.
# Copiar a .env y ajustar los valores según tu entorno.
#
# USO:
#   cp .env.example .env
#   # Editar .env con tus valores reales
#
# IMPORTANTE: Nunca commitear el archivo .env con secrets reales

# =========================
# APP CONFIGURACIÓN
# =========================
APP_NAME=WorkPlace
ENVIRONMENT=production # development/production

EMAIL=admin@playrke.com # EMAIL TRAEFIK

NODE_PORT=3001           # Puerto interno del backend (Docker)
FRONTEND_PORT=3000       # Puerto interno del frontend (Docker)
NITRO_HOST=0.0.0.0       # IMPORTANTE: Necesario para Docker, escucha en todas las interfaces

# =========================
# NODE MEMORY CONFIGURACIÓN
# =========================
NODE_OPTIONS=--max-old-space-size=512
# Limita el uso de memoria de Node.js a 512MB por contenedor
# Ajustar según recursos disponibles del servidor

# =========================
# NGINX CONFIGURACIÓN
# =========================
HTTP_PORT=80            # Puerto HTTP estándar
HTTPS_PORT=443          # Puerto HTTPS estándar

# Certbot Settings
STAGING_MODE=false       # false=producción, true=staging (pruebas)
DEV_MODE=false         # false=producción (Let's Encrypt), true=desarrollo (auto-firmado)
# USAR DEV_MODE=true SOLO para desarrollo local sin dependencia de red/firewall

# =========================
# POSTGRESQL (Docker internal)
# =========================
POSTGRES_USER=workplace
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# IMPORTANTE: Usar password fuerte (mínimo 16 caracteres, mezcla mayúsculas, minúsculas, números, símbolos)
POSTGRES_DB=workplace_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Nota: postgres es el hostname del contenedor Docker

# =========================
# REDIS (Docker internal)
# =========================
REDIS_HOST=redis         # Hostname del contenedor Redis
REDIS_PORT=6379          # Puerto estándar Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# IMPORTANTE: Usar password fuerte para Redis

# =========================
# JWT CONFIGURACIÓN (MUY IMPORTANTE)
# =========================
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
# CRÍTICO: Cambiar por string aleatorio mínimo 32 caracteres
# Generar con: openssl rand -base64 32
JWT_EXPIRES_IN=15m       # Tiempo expiración access token (15 minutos recomendado)
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_MIN_32_CHARS
# CRÍTICO: Cambiar por string aleatorio diferente a JWT_SECRET
JWT_REFRESH_EXPIRES_IN=7d # Tiempo expiración refresh token (7 días recomendado)

# =========================
# URLs CONFIGURACIÓN (PRODUCCIÓN - MONOLITO)
# =========================
DOMAIN=${DOMAIN:-your-domain.com}
# IMPORTANTE: Cambiar por tu dominio real (ej: miempresa.com)
FRONTEND_URL=https://${DOMAIN}       # HTTPS obligatorio en producción
API_URL=https://${DOMAIN}/api         # URL completa para API (monolito)
# Nota: /api usa mismo dominio, sin CORS, más simple

# =========================
# DOCKER CONFIGURACIÓN
# =========================
DOCKER_USER=${DOCKER_USER:-your-docker-user}
# Usuario para construir y ejecutar imágenes Docker
# Generalmente tu username de Docker Hub o registry

# =========================
# GOOGLE OAUTH CONFIGURACIÓN (OPCIONAL)
# =========================
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-YOUR_GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:-YOUR_GOOGLE_CLIENT_SECRET}
# Obtener desde: https://console.cloud.google.com/apis/credentials
# Crear OAuth 2.0 Client ID para Web application

# =========================
# CRON SCHEDULER CONFIGURACIÓN
# =========================
POSTGRES_SCHEDULE="0 2 * * *"      # Daily at 2 AM - PostgreSQL backup
REDIS_SCHEDULE="0 3 * * *"          # Daily at 3 AM - Redis backup  
VALIDATION_SCHEDULE="0 4 * * *"    # Daily at 4 AM - Backup validation
LOG_ROTATION_SCHEDULE="0 5 * * *"  # Daily at 5 AM - Log rotation

# =========================
# MINIO CONFIGURACIÓN
# =========================
MINIO_ROOT_USER=${MINIO_ROOT_USER:-minioadmin}
MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-minioadmin123}
# IMPORTANTE: Cambiar passwords en producción
