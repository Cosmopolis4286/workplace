# =========================
# APP
# =========================
APP_NAME=WorkPlace
NODE_ENV=development

NODE_PORT=${NODE_PORT:-3001}           # Puerto del backend Node/Nest
FRONTEND_PORT=${FRONTEND_PORT:-3000}   # Puerto del frontend Nuxt
NITRO_HOST=0.0.0.0                     # Necesario para Docker, escucha en todas las interfaces

# =========================
# NODE (MEMORIA)
# =========================
NODE_OPTIONS=--max-old-space-size=512  # Limita Node a 512 MB

# =========================
# PostgreSQL (Docker service)
# =========================
POSTGRES_USER=${POSTGRES_USER:-workplace}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-workplace_secret}
POSTGRES_DB=${POSTGRES_DB:-workplace_db}
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# =========================
# Redis (Docker service)
# =========================
REDIS_HOST=${REDIS_HOST:-redis}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_PASSWORD=${REDIS_PASSWORD:-redis_secret}

# =========================
# JWT
# =========================
JWT_SECRET=${JWT_SECRET:-dev_secret_${RANDOM}}
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET:-dev_refresh_${RANDOM}}
JWT_REFRESH_EXPIRES_IN=7d

# =========================
# URLs
# =========================
DOMAIN_HOST=${DOMAIN_HOST:-localhost}
FRONTEND_URL=http://${DOMAIN_HOST}:${FRONTEND_PORT}
BACKEND_API_URL=http://${DOMAIN_HOST}:${NODE_PORT}/api

# =========================
# Google OAuth (dev placeholders)
# =========================
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-YOUR_GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:-YOUR_GOOGLE_CLIENT_SECRET}