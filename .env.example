# =========================
# APP
# =========================
NODE_ENV=production # development | production
NODE_PORT=3001 # puerto del backend
FRONTEND_PORT=3000 # puerto del frontend

# =========================
# NODE (MEMORIA)
# =========================
NODE_OPTIONS=--max-old-space-size=512 # memoria maxima del proceso node

# PostgreSQL
POSTGRES_USER=workplace
POSTGRES_PASSWORD=workplace_secret
POSTGRES_DB=workplace_db
DATABASE_URL=postgresql://workplace:workplace_secret@localhost:5432/workplace_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# JWT
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# URLs
FRONTEND_URL=http://localhost:${FRONTEND_PORT}
NUXT_PUBLIC_API_URL=http://localhost:${NODE_PORT}/api

# GOOGLE
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET