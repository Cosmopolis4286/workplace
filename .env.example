# =========================
# APP
# =========================
NODE_ENV=development
NODE_PORT=3001           # Puerto del backend Node/Nest
FRONTEND_PORT=3000       # Puerto del frontend Nuxt
NITRO_HOST=0.0.0.0       # Necesario para Docker para escuchar en todas las interfaces

# =========================
# NODE (MEMORIA)
# =========================
NODE_OPTIONS=--max-old-space-size=512  # Limita Node a 512 MB

# =========================
# PostgreSQL (Docker service)
# =========================
POSTGRES_USER=workplace
POSTGRES_PASSWORD=workplace_secret
POSTGRES_DB=workplace_db
# Conexión desde backend dentro del contenedor al servicio postgres
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# =========================
# Redis (Docker service)
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# =========================
# JWT
# =========================
JWT_SECRET=super_secret_jwt_key_change_in_development
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_development
JWT_REFRESH_EXPIRES_IN=7d

# =========================
# URLs
# =========================
FRONTEND_URL=http://localhost:${FRONTEND_PORT}
NUXT_PUBLIC_API_URL=http://localhost:${NODE_PORT}/api

# =========================
# Google OAuth (dev placeholders)
# =========================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET