{
  "name": "workplace-manager",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "migrate": "pnpm --filter backend prisma:migrate",
    "migrate:deploy": "pnpm --filter backend exec prisma migrate deploy --schema=./prisma/schema.prisma",
    "seed": "pnpm --filter backend seed",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  },
  "pnpm": {
    "overrides": {
      "@nuxt/devtools": ">=3.3.1",
      "proxy-addr": ">=2.0.8",
      "seroval": ">=1.6.2",
      "shell-quote": ">=1.8.4",
      "simple-git": ">=4.0.1",
      "tar": ">=7.5.19"
    }
  }
}
