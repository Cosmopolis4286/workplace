{
  "name": "workplace-manager",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "migrate": "pnpm --filter backend prisma:migrate",
    "migrate:deploy": "pnpm --filter backend exec prisma migrate deploy --schema=./prisma/schema.prisma",
    "seed": "pnpm --filter backend seed",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "install:all": "pnpm install",
    "format:fix": "pnpm --filter backend format",
    "format:check": "pnpm --filter backend format:check",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^20.11.5"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.3.0": "^2.3.0",
      "lodash@<4.18.0": "^4.18.0",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "tmp@<0.2.6": "^0.2.6"
    },
    "packageExtensions": {
      "@vite-pwa/nuxt@1": {
        "dependencies": {
          "h3": "^1.15.11"
        }
      }
    }
  }
}
