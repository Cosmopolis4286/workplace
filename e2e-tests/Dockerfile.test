# Dockerfile específico para E2E Tests - Basado en imagen oficial de Playwright
# La versión de la imagen debe coincidir con @playwright/test en package.json
# (fijada sin ^): los navegadores de la imagen solo sirven para esa versión.
FROM mcr.microsoft.com/playwright:v1.59.1-jammy

WORKDIR /app

# Copiar archivos de dependencias
COPY package.json ./
COPY tests/ ./tests/
COPY playwright.config.ts ./

# Instalar dependencias
RUN npm install

# Crear directorio para reportes
RUN mkdir -p /app/playwright-report

# Exponer puerto para debug
EXPOSE 9323

# Comando por defecto
CMD ["npx", "playwright", "test", "--reporter=html"]
