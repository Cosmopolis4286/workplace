# ================================
# Dependencies
# ================================
node_modules/
**/node_modules/

# ================================
# Package managers
# ================================
.pnpm-debug.log*
pnpm-debug.log*
.yarn-integrity
.npm
.npmrc
.pnpm-store/
# Lockfile generado al correr pnpm install desde una subcarpeta del workspace
# (el workspace usa el pnpm-lock.yaml de la raíz)
backend/pnpm-lock.yaml
frontend/pnpm-lock.yaml

# ================================
# Nuxt (frontend)
# ================================
frontend/.nuxt/
frontend/.nitro/
frontend/.cache/
frontend/.output/
frontend/.data/
frontend/dist/

# ================================
# NestJS (backend)
# ================================
backend/dist/
backend/*.tsbuildinfo
backend/uploads/

# ================================
# Prisma
# ================================
backend/prisma/generated/

# ================================
# Environment variables
# ================================
# Cualquier archivo .env* (incluye backend/.env, .env.dev, .env.local.prod,
# backend/.env.test, etc.) — el patrón anterior solo cubría nombres exactos
# y dejó pasar variantes reales que terminaron trackeadas con secretos de
# producción versionados (.env.dev, .env.local.prod, backend/.env.test).
.env*
!.env*.example
!**/.env*.example

# ================================
# Logs
# ================================
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

