uploads/
private-uploads/
storage/

# ================================
# Docker
# ================================
# Docker ignore files (deben ser incluidos)
!.dockerignore
!frontend/.dockerignore
!backend/.dockerignore

# Docker build temp (ignorar)
.docker/
*.dockerfile.tmp
docker-compose.override.yml

# Docker volumes locales (ignorar)
postgres_data/
redis_data/
uploads_data/
logs_data/

# Docker secrets (ignorar)
*.docker.key
*.docker.crt

# ================================
# SSL Certificates (Development & Production)
# ================================
etc/letsencrypt/
certbot/test-certs/
certbot/www/.well-known/
*.pem
*.crt
*.key
!scripts/dev/generate-dev-certs.sh
!scripts/dev/setup-dev-ssl.sh

# ================================
# Claude Code
# ================================
.claude/

