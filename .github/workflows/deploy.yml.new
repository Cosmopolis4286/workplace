name: Production Deploy

on:
  push:
    branches: [ main ]
  workflow_dispatch:
    inputs:
      force_deploy:
        description: 'Force deploy even if tests fail'
        required: false
        default: false
        type: boolean

env:
  REGISTRY: docker.io
  IMAGE_NAME: ${{ secrets.DOCKER_USERNAME }}/workplace

jobs:
  # 1. Tests Unitarios con Coverage
  test:
    name: Run Tests with Coverage
    uses: ./.github/workflows/scripts/run-tests.yml
    with:
      force-deploy: ${{ github.event.inputs.force_deploy }}
      coverage-threshold: '80'
    secrets: inherit

  # 2. Tests E2E (solo en main)
  e2e-tests:
    name: Run E2E Tests
    uses: ./.github/workflows/scripts/run-e2e.yml
    needs: test
    if: github.ref == 'refs/heads/main'
    secrets: inherit

  # 3. Build Docker Images
  build:
    name: Build Docker Images
    uses: ./.github/workflows/scripts/build-images.yml
    needs: [test, e2e-tests]
    with:
      docker-username: ${{ secrets.DOCKER_USERNAME }}
      docker-password: ${{ secrets.DOCKER_PASSWORD }}
      image-tag: 'main-${{ github.sha }}'
    secrets:
      DOCKER_USERNAME: ${{ secrets.DOCKER_USERNAME }}
      DOCKER_PASSWORD: ${{ secrets.DOCKER_PASSWORD }}

  # 4. Deploy a Producción
  deploy:
    name: Deploy to Production
    uses: ./.github/workflows/scripts/deploy-infrastructure.yml
    needs: build
    with:
      production-user: ${{ secrets.PRODUCTION_USER }}
      production-host: ${{ secrets.PRODUCTION_HOST }}
      backend-image: ${{ secrets.DOCKER_USERNAME }}/workplace-backend:main-${{ github.sha }}
      frontend-image: ${{ secrets.DOCKER_USERNAME }}/workplace-frontend:main-${{ github.sha }}
      domain-name: ${{ secrets.DOMAIN_NAME || 'localhost' }}
      force-deploy: ${{ github.event.inputs.force_deploy }}
    secrets:
      PRODUCTION_USER: ${{ secrets.PRODUCTION_USER }}
      PRODUCTION_HOST: ${{ secrets.PRODUCTION_HOST }}
      DOMAIN_NAME: ${{ secrets.DOMAIN_NAME }}

  # 5. Post-Deploy Verification
  verify:
    runs-on: ubuntu-latest
    needs: deploy
    timeout-minutes: 10
    
    steps:
    - name: Setup SSH known hosts
      run: |
        ssh-keyscan -H ${{ secrets.PRODUCTION_HOST }} >> ~/.ssh/known_hosts

    - name: Post-Deploy Health Check
      run: |
        ssh -o StrictHostKeyChecking=no ${{ secrets.PRODUCTION_USER }}@${{ secrets.PRODUCTION_HOST }} << 'EOF'
          set -euo pipefail
          cd /opt/workplace
          
          echo "🔍 Post-deploy verification..."
          
          # Verificar servicios
          docker compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}"
          
          # Health checks
          echo "🏥 Health checks:"
          if docker compose exec --no-TTY backend curl -f http://localhost:3001/api/health; then
            echo "✅ Backend health check OK"
          else
            echo "❌ Backend health check FAILED"
            exit 1
          fi
          
          if docker compose exec --no-TTY frontend curl -f http://localhost:3000; then
            echo "✅ Frontend health check OK"
          else
            echo "❌ Frontend health check FAILED"
            exit 1
          fi
          
          # Verificar logs recientes
          echo "📋 Recent logs:"
          docker compose logs --tail=5 --no-color
          
          echo "✅ Deployment verification completed successfully"
        EOF

    - name: Notify Success
      run: |
        echo "🎉 Deployment completed successfully!"
        echo "📊 Summary:"
        echo "- ✅ Tests passed"
        echo "- ✅ E2E tests passed" 
        echo "- ✅ Images built and pushed"
        echo "- ✅ Infrastructure deployed"
        echo "- ✅ Health checks passed"
