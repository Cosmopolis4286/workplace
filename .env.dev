# =========================
# APP
# =========================
APP_NAME=WorkPlace
APP_ENV=development
USE_DEMO=true

# EMAIL TRAEFIK
EMAIL=admin@playrke.com 

NODE_PORT=3001           
FRONTEND_PORT=3000      
NITRO_HOST=0.0.0.0      

# =========================
# Node memory
# =========================
NODE_OPTIONS=--max-old-space-size=512

# =========================
# Nginx (desarrollo)
# =========================
HTTP_PORT=80
HTTPS_PORT=443
DEV_MODE=true
STAGING_MODE=false

# =========================
# PostgreSQL (Docker internal)
# =========================
# Este archivo SÍ se versiona — no debe contener secretos reales. Copiar a
# .env.dev.local (gitignored) y reemplazar los CHANGE_ME_* con valores
# generados si necesitas levantar el stack localmente.
POSTGRES_USER=workplace
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=workplace_db
# DATABASE_URL se define en docker-compose.lite.dev.yml

# =========================
# Redis (Docker internal)
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=kK8JJn9M9N9KTTAYSXGjzOhyvzOh3GMj

# =========================
# JWT (desarrollo)
# =========================
JWT_SECRET=dev_secret_change_in_production_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_12345
JWT_REFRESH_EXPIRES_IN=7d

# =========================
# reCAPTCHA v3 (login/register) — vacío = validación deshabilitada (dev)
# =========================
RECAPTCHA_SECRET_KEY=
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=

# =========================
# Cifrado (2FA - secretos TOTP en reposo, AES-256-GCM)
# =========================
ENCRYPTION_KEY=99c13edfcde8a21f928683342096ff969efd2c2d68173740e8a977325faee284

# =========================
# URLs (desarrollo local - MONOLITO)
# =========================
DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001/api

# =========================
# Docker
# =========================
DOCKER_USER=eiskerhc

# =========================
# Google OAuth (dev placeholders)
# =========================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET