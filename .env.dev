# =========================
# APP
# =========================
APP_NAME=WorkPlace
APP_ENV=development
DEV_MODE=true  

EMAIL=admin@playrke.com # EMAIL TRAEFIK

NODE_PORT=3001           # Backend
FRONTEND_PORT=3000       # Frontend
NITRO_HOST=0.0.0.0       # Escuchar en todas las interfaces

# =========================
# Node memory
# =========================
NODE_OPTIONS=--max-old-space-size=512

# =========================
# Nginx (desarrollo)
# =========================
HTTP_PORT=80
HTTPS_PORT=443
DEV_MODE=true          # true=certificado auto-firmado, false=Let's Encrypt normal
STAGING_MODE=false     # true=staging, false=producción (aunque en desarrollo)

# =========================
# PostgreSQL (Docker internal)
# =========================
POSTGRES_USER=workplace
POSTGRES_PASSWORD=9FmK2xN8pL4qR7vT3wS6zY1iG5jB8nE2cV5aI9d=
POSTGRES_DB=workplace_db
# DATABASE_URL se define en docker-compose.lite.dev.yml

# =========================
# Redis (Docker internal)
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret

# =========================
# JWT (desarrollo)
# =========================
JWT_SECRET=dev_secret_change_in_production_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_12345
JWT_REFRESH_EXPIRES_IN=7d

# =========================
# URLs (desarrollo local - MONOLITO)
# =========================
DOMAIN=localhost
FRONTEND_URL=http://localhost:3000       # HTTP para desarrollo
API_URL=http://localhost:3001/api        # URL completa para API (monolito)

# =========================
# Docker
# =========================
DOCKER_USER=eiskerhc

# =========================
# Google OAuth (dev placeholders)
# =========================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
