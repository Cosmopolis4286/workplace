# =========================
# APP
# =========================
APP_NAME=WorkPlace
APP_ENV=development
USE_DEMO=true

# EMAIL TRAEFIK
EMAIL=admin@playrke.com 

NODE_PORT=3001           
FRONTEND_PORT=3000      
NITRO_HOST=0.0.0.0      

# =========================
# Node memory
# =========================
NODE_OPTIONS=--max-old-space-size=512

# =========================
# Nginx (desarrollo)
# =========================
HTTP_PORT=80
HTTPS_PORT=443
DEV_MODE=true
STAGING_MODE=false

# =========================
# PostgreSQL (Docker internal)
# =========================
POSTGRES_USER=workplace
POSTGRES_PASSWORD=REDACTED_ROTATED_SECRET
POSTGRES_DB=workplace_db
# DATABASE_URL se define en docker-compose.lite.dev.yml

# =========================
# Redis (Docker internal)
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REDACTED_ROTATED_SECRET

# =========================
# JWT (desarrollo)
# =========================
JWT_SECRET=dev_secret_change_in_production_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_12345
JWT_REFRESH_EXPIRES_IN=7d

# =========================
# Cifrado (2FA - secretos TOTP en reposo, AES-256-GCM)
# =========================
ENCRYPTION_KEY=REDACTED_ROTATED_SECRET

# =========================
# URLs (desarrollo local - MONOLITO)
# =========================
DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001/api

# =========================
# Docker
# =========================
DOCKER_USER=eiskerhc

# =========================
# Google OAuth (dev placeholders)
# =========================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET