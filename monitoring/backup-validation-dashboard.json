    "annotations": {
      "list": [
        {
          "name": "Backup Failures",
          "datasource": "Loki",
          "enable": true,
          "expr": "{service=~\"backup-.*\"} |= \"ERROR\"",
          "iconColor": "red",
          "tags": ["backup", "error"],
          "type": "tags"
        }
